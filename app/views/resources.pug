extends layout

include _fe-page-header
include _fe-cards

block body
  //- Was: bootstrap cards on the stars parallax. Same list, same
  //- destinations, same Open Graph images, on the fe page header and the
  //- shared card grid (see _fe-cards.pug).
  - const tools = [];
  - const list = ["/faq", "/help", "/about", "/press", "/privacy", "/terms", "/gdpr", "/dpa", "/report-abuse", "/blog/docs/best-quantum-safe-encrypted-email-service", "/guides", "/blogs/docs", "/private-business-email", "/disposable-addresses", "/domain-registration", "/reserved-email-addresses", "/denylist"];
  each item in list
    - const match = config.meta[item];
    if match
      - tools.push({ title: match[0].replace(config.metaTitleAffix, ""), description: match[1], slug: item, image: match[2] });
  .fe-landing(class=isFeFlushNav ? "fe-landing--flush" : "")
    +fePageHeader({ id: "fe-resources", icon: "fa fa-toolbox", eyebrow: t("Resources"), title: t("Free Startup and Developer Email Tools List"), body: t("Listed below are free email resources and tools for startups and developers.") })
      .fe-page-header__meta
        +feByline
    section.fe-section.fe-surface-light.fe-section--pad-sm.fe-body.no-search
      .fe-container
        ul.fe-grid.fe-grid--md-2.fe-grid--lg-3
          each tool, i in tools
            +feCard({ title: t(tool.title), description: t(tool.description), href: l(tool.slug), alt: striptags(t(tool.title)), image: tool.image ? manifest(tool.image) : l(`${tool.slug}.png`), eager: i <= 2 })
