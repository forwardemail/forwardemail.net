extends layout

include _fe-page-header
include _fe-onboard

block body
  //- Was: the auto-opening onboarding modal, then a centred header and a
  //- numbered list of vanity domains with bootstrap buttons. Same content
  //- on the fe page header, a callout, one row per vanity domain, and the
  //- onboarding form inline at the foot.
  .fe-landing(class=isFeFlushNav ? "fe-landing--flush" : "")
    +fePageHeader({ id: "fe-disposable", icon: "fa fa-mail-bulk", eyebrow: t("Short and Memorable Vanity Domains"), title: t("Disposable Addresses"), body: t("Use your own custom domain name or try one of our vanity domain names.") })
      .fe-actions.fe-page-header__actions
        a.fe-btn.fe-btn--hero.fe-btn--lg.fe-btn--glow(
          href="/my-account/domains/aliases/new"
        )
          = t("Create your address")
          i.fa.fa-angle-right(aria-hidden="true")

    section.fe-section.fe-surface-light.fe-section--pad-sm.fe-body(
      aria-labelledby="fe-disposable-list-title"
    )
      .fe-container.fe-body__inner
        .fe-panel.fe-panel--md.fe-callout
          i.fa.fa-lightbulb(aria-hidden="true")
          div!= t('<strong>Did you know?</strong> You can use your own custom domain name as a disposable email address.  Just <a href="/my-account/domains/new" class="alert-link">add a new domain</a> today to get started.')
        h2#fe-disposable-list-title.fe-display-sm.fe-body__title= t("Short and Memorable Vanity Domains")
        ol.fe-vanity
          each vanityDomain in config.vanityDomains
            li.fe-panel.fe-panel--md.fe-vanity__row
              span.fe-vanity__addr= `${t("name")}@${vanityDomain}`
              a.fe-btn.fe-btn--subtle.fe-btn--md(
                href=`/my-account/domains/aliases/new?domain=${vanityDomain}`
              )
                = t("Try it now")
                i.fa.fa-angle-right(aria-hidden="true")
        .fe-actions.fe-body__actions
          a.fe-btn.fe-btn--hero.fe-btn--lg(
            href="/my-account/domains/aliases/new"
          )
            = t("Create your address")
            i.fa.fa-angle-right(aria-hidden="true")

    +feOnboard(t('Disposable addresses'), t('Ready to get started and create a disposable email address?'), `${l('/faq')}?redirect_to=${l('/my-account/domains/aliases/new')}`, l('/my-account/domains/aliases/new'))
