//- Redesigned product section, per section 3 of the landing page build spec.
//- Light surface. Numeric values are emitted as literals rather than through
//- t(), so the translation job never rewrites a figure or a currency symbol.
mixin feProduct
  section.fe-section.fe-surface-light.fe-section--pad.fe-product(
    aria-labelledby="fe-product-title"
  )
    .fe-container
      p.fe-eyebrow.fe-label
        i.fa.fa-check(aria-hidden="true")
        = t("All-in-one, no add-on fees")

      .fe-product__head
        h2#fe-product-title.fe-display-lg= t("One dashboard for forwarding, mailboxes, sending and delivery.")

        ul.fe-stats.fe-product__stats
          li
            span.fe-stats__value.fe-numeral 99.99%
            = " "
            span.fe-stats__label.fe-label= t("Uptime")
          li
            span.fe-stats__value.fe-numeral 10 GB
            = " "
            span.fe-stats__label.fe-label= t("Pooled storage")
          li
            span.fe-stats__value.fe-numeral $0
            = " "
            span.fe-stats__label.fe-label= t("Per alias")

      //- Section 7 replacement copy. The mockup line here described the
      //- redesign rather than the product. The tour video sits beside it
      //- (see _fe-video.pug).
      .fe-product__intro
        //- Opens with the answer to the heading above.
        p.fe-lede= t("Add your domain, prove you own it and route its mail. Then watch the results in one place.")
        //- eager: the first image on the page after the logo
        +feVideoCard("tour", "eager")

      hr.fe-divider

      //- Route stepper. The colour sequence blue, cyan, mint, blue encodes
      //- progression and is intentional per section 3.1.
      p.fe-stepper__label.fe-label= t("The route")
      ol.fe-stepper
        +feStep("01", "primary", t("Connect"), t("Add unlimited domains and aliases"))
        +feStep("02", "signal", t("Authenticate"), "SPF, DKIM, DMARC, MTA-STS, DANE")
        +feStep("03", "mint", t("Route + store"), t("Forward, send via SMTP, or keep encrypted mail"))
        +feStep("04", "primary", t("Observe"), t("Analytics, DMARC reports, webhooks, API"))

      .fe-features
        .fe-panel.fe-feature
          h3.fe-display-sm.fe-feature__title= t("Privacy by default")
          //- Each claim can be checked: the FAQ says what is stored where,
          //- the audits were in May and August 2026 (see the report),
          //- and the audit report is published
          p.fe-text.fe-feature__body
            = t("Forwarded mail is processed in memory and never written to disk.")
            = " "
            = t("Each mailbox is its own encrypted SQLite file that only your password can open.")
            = " "
            != t('Cure53 has audited our code twice, in %s and %s, and <a href="%s" target="_blank" rel="noopener">its report</a> is public.', new Intl.DateTimeFormat(locale, { month: "long", year: "numeric", timeZone: "UTC" }).format(new Date("2026-05-01")), new Intl.DateTimeFormat(locale, { month: "long", year: "numeric", timeZone: "UTC" }).format(new Date("2026-08-01")), "/pentest-report_forward-email.pdf")
            = " "
            a.fe-feature__link(
              href=l("/faq#where-is-inbound-email-for-my-domain-processed-and-stored-and-for-how-long")
            )= t("What we store, and for how long")
          ul.fe-chips
            li.fe-chip
              i.fab.fa-github(aria-hidden="true")
              = t("Open-source")
            li.fe-chip
              i.fa.fa-lock.fe-chip__icon--success(aria-hidden="true")
              = t("PGP forwarding")
            li.fe-chip
              i.fa.fa-shield-alt.fe-chip__icon--primary(aria-hidden="true")
              = t("Spam + phishing guard")

        //- The only inverse panel in this section. .fe-surface-dark re-points
        //- the semantic tokens for this subtree, so nothing inside needs a
        //- per-element colour override.
        .fe-feature.fe-feature--inverse.fe-surface-dark
          h3.fe-display-sm.fe-feature__title= t("Built for developers")
          p.fe-text.fe-feature__body
            = t("Everything the dashboard does is an API call. Send with one request, receive as JSON webhooks, and script the rest.")
            = " "
            = t("Our webmail and our apps for %d platforms use the same API.", 6)
            = " "
            a.fe-feature__link(href=l("/email-api"))= t("Read the API reference")
          .fe-codeblock
            pre
              code
                span.fe-tok-method POST /v1/emails
                = "\n"
                span.fe-tok-key { "from"
                span.fe-tok-value : "you@domain.com",
                = " "
                span.fe-tok-key "to"
                span.fe-tok-value : "customer@co.com" }
                = "\n"
                span.fe-tok-result → 202 Accepted · signed · tracked
          //- One chip per protocol rather than one chip listing them all, so
          //- each reads as a capability and the row wraps cleanly on mobile.
          ul.fe-chips
            li.fe-chip.fe-chip--code REST API
            li.fe-chip.fe-chip--code SMTP
            li.fe-chip.fe-chip--code IMAP
            li.fe-chip.fe-chip--code POP3
            li.fe-chip.fe-chip--code CalDAV
            li.fe-chip.fe-chip--code CardDAV
            li.fe-chip.fe-chip--code= t("Webhooks")

      //- Unlimited, reputation-based sending (see config.smtpReputationTiers)
      - const feSendingTiers = config.smtpReputationTiers;
      .fe-panel.fe-sending
        div
          p.fe-eyebrow.fe-label
            i.fa.fa-paper-plane(aria-hidden="true")
            = t("Unlimited sending")
          h3.fe-display-sm.fe-sending__title= t("Unlimited outbound email, earned by reputation.")
          - const badDayRate = new Intl.NumberFormat(locale, { style: "percent", maximumFractionDigits: 2, numberingSystem: "latn" }).format(config.smtpReputationBadDayReportRate);
          p.fe-text.fe-sending__body
            = t("Send with SMTP or the API on any paid plan from $%d/mo. New senders start at %d messages a day (%d on the Team plan). Your daily limit grows as you keep paying and send clean mail.", planPricing.enhanced, feSendingTiers[0].limit, config.smtpTeamLimitMessages)
            = " "
            != t('According to <a href="%s" target="_blank" rel="noopener noreferrer">Gmail\'s sender guidelines</a>, senders should keep their spam rate under %s.', "https://support.google.com/a/answer/81126", badDayRate)
            = " "
            = t("We use the same rate. If big mail providers reject %s or more of your recipients as spam or viruses in a day, your limit can drop one step.", badDayRate)
          a.fe-feature__link(href=l("/faq#what-are-your-outbound-smtp-limits"))= t("How sending thresholds work")
        div
          ol.fe-sending__tiers(aria-label=t("Daily sending thresholds"))
            each tier, index in feSendingTiers
              li.fe-chip.fe-numeral(
                class=index === feSendingTiers.length - 1 ? "fe-sending__tier--top" : ""
              )
                = tier.limit.toLocaleString("en")
                if index === feSendingTiers.length - 1
                  | +
          p.fe-sending__unit= t("messages per day, unlocked as your reputation grows")

mixin feStep(num, dot, title, desc)
  li.fe-stepper__step
    span.fe-stepper__num.fe-code= num
    .fe-stepper__dot-row(aria-hidden="true")
      span.fe-stepper__dot(class=`fe-stepper__dot--${dot}`)
      span.fe-stepper__rule
    //- A label in the ordered list. Each step is one line, so as headings
    //- the four read as four thin sections to screen readers and machine
    //- readers.
    p.fe-display-sm.fe-stepper__title= title
    p.fe-text.fe-stepper__desc= desc
