//- Verification section. Dark surface, closing the page the way the landing
//- page closes on dark.
//- The command is a literal, not translated copy: it is something a visitor
//- pastes into a shell, and a translated flag would not run.
mixin feDownloadVerify
  -
    //- Name a file that is actually in this release, so the command runs as
    //- written rather than sending someone to fix a placeholder first. Falls
    //- back to the generic form when there is no live release to name.
    const sample = downloads.options.find((o) => o.fileName);
    const sampleName = sample ? sample.fileName : t("the file you downloaded");
  section.fe-section.fe-surface-dark.fe-dl-verify(
    aria-labelledby="fe-download-verify-title"
  )
    .fe-container
      p.fe-eyebrow.fe-label
        i.fa.fa-lock(aria-hidden="true")
        = t("Verify before you install")

      .fe-dl-verify__grid
        div
          h2#fe-download-verify-title.fe-dl-verify__title= t("Check what you downloaded.")
          p.fe-lede= t("Every release publishes a checksum for each file. Compare the one you got against the published list, and it either matches or it does not.")

          .fe-codeblock
            pre
              code
                span.fe-tok-method shasum
                //- an explicit space: a lone pipe emits nothing, which
                //- rendered this as "shasum-a 256"
                = " "
                span.fe-tok-key -a 256
                = " "
                //- js/download.js swaps this for the file the hero actually
                //- offers this visitor, so the example matches their download
                span#fe-download-verify-sample= sampleName

          ul.fe-dl-verify__links
            li
              a.fe-dl-verify__link(href=downloads.checksumsUrl, rel="noopener")
                i.fa.fa-file-text-o(aria-hidden="true")
                = t("SHA256SUMS.txt")
            li
              a.fe-dl-verify__link(href=downloads.releaseUrl, rel="noopener")
                i.fa.fa-tag(aria-hidden="true")
                = t("Release notes")
            li
              a.fe-dl-verify__link(
                href=downloads.allReleasesUrl,
                rel="noopener"
              )
                i.fa.fa-history(aria-hidden="true")
                = t("All releases")

        ul.fe-dl-verify__points
          li.fe-dl-verify__point
            span.fe-dl-verify__point-icon.fe-dl-verify__point-icon--mint
              i.fa.fa-check(aria-hidden="true")
            span
              strong.fe-dl-verify__point-title= t("Signed updates")
              span.fe-dl-verify__point-body= t("Desktop builds carry a signature the auto updater checks before it applies anything.")
          li.fe-dl-verify__point
            span.fe-dl-verify__point-icon.fe-dl-verify__point-icon--signal
              i.fa.fa-code(aria-hidden="true")
            span
              strong.fe-dl-verify__point-title= t("Built in the open")
              span.fe-dl-verify__point-body= t("Each file here is the artifact a public CI run produced from a public commit.")
          li.fe-dl-verify__point
            span.fe-dl-verify__point-icon.fe-dl-verify__point-icon--primary
              i.fa.fa-github(aria-hidden="true")
            span
              strong.fe-dl-verify__point-title= t("Read the source")
              span
                a.fe-dl-verify__point-link(
                  href=downloads.repoUrl,
                  rel="noopener"
                )= t("mail.forwardemail.net")
