//- Verification section. Dark surface, closing the page the way the landing
//- page closes on dark.
//- The commands are literals, not translated copy: they are something a
//- visitor pastes into a shell, and a translated flag would not run.
mixin feDownloadVerify
  -
    //- Name a file that is actually in this release, so the commands run as
    //- written rather than sending someone to fix a placeholder first. Falls
    //- back to the generic form when there is no live release to name.
    const sample = downloads.options.find((o) => o.fileName);
    const sampleName = sample ? sample.fileName : t("the file you downloaded");
    const fdroid = downloads.verify.fdroid;
  section.fe-section.fe-surface-dark.fe-section--pad.fe-download-verify(
    aria-labelledby="fe-download-verify-title"
  )
    .fe-container
      p.fe-eyebrow.fe-label
        i.fa.fa-lock(aria-hidden="true")
        = t("Verify before you install")

      .fe-download-verify__grid
        div
          h2#fe-download-verify-title.fe-display-lg.fe-download-verify__title= t("Check what you downloaded.")
          p.fe-lede= t("Every release publishes a checksum for each file. Compare the one you got against the published list, and it either matches or it does not.")

          .fe-codeblock
            pre
              code
                span.fe-tok-method shasum
                //- an explicit space: a lone pipe emits nothing, which
                //- rendered this as "shasum-a 256"
                = " "
                span.fe-tok-key -a 256
                = " "
                //- js/download.js swaps this for the file the hero actually
                //- offers this visitor, so the example matches their download
                span.fe-download-verify__sample= sampleName

          ul.fe-download-verify__links
            li
              a.fe-download-verify__link(
                href=downloads.checksumsUrl,
                rel="noopener"
              )
                i.fa.fa-file-text-o(aria-hidden="true")
                = t("SHA256SUMS.txt")
            li
              a.fe-download-verify__link(
                href=downloads.releaseUrl,
                rel="noopener"
              )
                i.fa.fa-tag(aria-hidden="true")
                = t("Release notes")
            li
              a.fe-download-verify__link(
                href=downloads.allReleasesUrl,
                rel="noopener"
              )
                i.fa.fa-history(aria-hidden="true")
                = t("All releases")

        ul.fe-download-verify__points
          li.fe-download-verify__point
            span.fe-icon-tile.fe-icon-tile--sm.fe-icon-tile--success
              i.fa.fa-check(aria-hidden="true")
            span
              strong.fe-download-verify__point-title= t("Signed updates")
              span.fe-text.fe-download-verify__point-body= t("Desktop builds carry a minisign signature the auto updater checks against the key below before it applies anything.")
          li.fe-download-verify__point
            span.fe-icon-tile.fe-icon-tile--sm.fe-icon-tile--active
              i.fa.fa-code(aria-hidden="true")
            span
              strong.fe-download-verify__point-title= t("Built in the open")
              span.fe-text.fe-download-verify__point-body= t("Each file here is the artifact a public CI run produced from a public commit, and the run attests to it.")
          li.fe-download-verify__point
            span.fe-icon-tile.fe-icon-tile--sm.fe-icon-tile--lift
              i.fa.fa-github(aria-hidden="true")
            span
              strong.fe-download-verify__point-title= t("Read the source")
              span
                a.fe-download-verify__point-link(
                  href=downloads.repoUrl,
                  rel="noopener"
                )= t("mail.forwardemail.net")

      //- The keys and attestations a download can be checked against. Each
      //- value is shown in full beside its copy control, so it is readable
      //- and checkable with scripts blocked. Facts come from
      //- config/mail-app-channels.js; the F-Droid card follows that
      //- channel's state and shows its URL and fingerprint once it is live.
      ul.fe-download-verify__keys
        li.fe-panel.fe-download-verify__key
          span.fe-icon-tile.fe-icon-tile--sm.fe-icon-tile--primary
            i.fa.fa-key(aria-hidden="true")
          h3.fe-download-verify__key-title= t("Update signing key")
          p.fe-text.fe-download-verify__key-body= t("The auto updater applies only updates signed by this minisign key. It is the key in the app's own source, so the two should match.")
          .fe-download-verify__value
            code.fe-download-verify__code= downloads.verify.minisign.publicKey
            +feDownloadCopy(downloads.verify.minisign.publicKey, t("Copy the minisign public key"))
          span.fe-download-verify__key-meta.fe-numeral= t("Key ID %s", downloads.verify.minisign.keyId)

        li.fe-panel.fe-download-verify__key
          span.fe-icon-tile.fe-icon-tile--sm.fe-icon-tile--active
            i.fa.fa-shield(aria-hidden="true")
          h3.fe-download-verify__key-title= t("Build provenance")
          p.fe-text.fe-download-verify__key-body= t("Every installer carries SLSA provenance on Sigstore's public transparency log, tying it to the CI run and commit that built it. Check one with the GitHub CLI:")
          .fe-codeblock
            pre
              code
                span.fe-tok-method gh
                = " "
                span.fe-tok-key attestation verify
                = " "
                span.fe-download-verify__sample= sampleName
                = " "
                span.fe-tok-key --owner
                = " "
                span.fe-tok-value= downloads.verify.provenance.owner
          a.fe-download-verify__link(
            href=downloads.verify.provenance.url,
            rel="noopener"
          )
            i.fa.fa-external-link(aria-hidden="true")
            = t("All attestations")

        if fdroid
          li.fe-panel.fe-download-verify__key
            span.fe-icon-tile.fe-icon-tile--sm.fe-icon-tile--success
              i.fab.fa-android(aria-hidden="true")
            h3.fe-download-verify__key-title= t("F-Droid repository")
            if fdroid.state === "live"
              p.fe-text.fe-download-verify__key-body= t("Add the repository to your F-Droid client and confirm the fingerprint it shows matches this one before you install from it.")
              .fe-download-verify__value
                code.fe-download-verify__code= fdroid.url
                +feDownloadCopy(fdroid.url, t("Copy the F-Droid repository URL"))
              if fdroid.fingerprint
                .fe-download-verify__value
                  code.fe-download-verify__code= fdroid.fingerprint
                  +feDownloadCopy(fdroid.fingerprint, t("Copy the F-Droid repository fingerprint"))
            else
              p.fe-text.fe-download-verify__key-body= t("The repository index is signed with its own key. Its URL and certificate fingerprint appear here when it goes live, so a client can pin it.")
              span.fe-download-verify__key-meta
                span.fe-chip.fe-chip--soon= t("Coming soon")
