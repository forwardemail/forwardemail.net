//- Shared label maps for the download page.
//- An `include` is inlined by pug, so the constants below land in the scope of
//- whatever includes this, which is how the hero and the platform sections
//- both read them. Kept out of helpers/get-app-downloads.js because these go
//- through t() and t() only exists in the view.
//- The keys are the `arch` and `format` values the helper's matrix produces.
-
  const archLabels = {
    appleSilicon: t("Apple Silicon"),
    intel: t("Intel"),
    x64: t("64-bit"),
    arm64: t("ARM64"),
    universal: t("Universal")
  };

  //- File extensions and package-format names are product names, so they are
  //- literals. Only the words around them are translated.
  const formatLabels = {
    dmg: ".dmg",
    exe: ".exe",
    msi: ".msi",
    appimage: "AppImage",
    deb: ".deb",
    rpm: ".rpm",
    snap: "Snap",
    apk: ".apk",
    fdroid: "F-Droid",
    ipa: ".ipa"
  };

  //- The second line on each row, explaining what the format is for. Without
  //- it a visitor has to already know the difference between a .deb and a
  //- .rpm to pick correctly.
  const formatNotes = {
    dmg: t("Disk image"),
    exe: t("Installer"),
    msi: t("For managed deployment"),
    appimage: t("Runs without installing"),
    deb: t("Debian, Ubuntu, Mint"),
    rpm: t("Fedora, RHEL, openSUSE"),
    snap: t("Snap store package"),
    apk: t("Installs straight from your browser"),
    fdroid: t("Reproducible, for the F-Droid client"),
    ipa: t("Requires a sideloading tool")
  };

  //- On desktop the arch is what tells two builds apart, so it is the row
  //- title. On mobile every build is universal, so the arch says nothing and
  //- the format is the useful title instead.
  const universalTitles = {
    apk: t("Android package"),
    fdroid: t("F-Droid build"),
    ipa: t("iOS package")
  };

  //- Store and package-manager names are product names, so they are
  //- literals. Which channels a platform has, and whether each is live, is
  //- config/mail-app-channels.js; this only names and draws the platforms.
  const platformMeta = {
    macos: {
      name: "macOS",
      icon: "fab fa-apple",
      requires: t("macOS 10.15 or later")
    },
    windows: {
      name: "Windows",
      icon: "fab fa-windows",
      requires: t("Windows 10 or later")
    },
    linux: {
      name: "Linux",
      icon: "fab fa-linux",
      requires: t("GTK with WebKit2GTK 4.1")
    },
    android: {
      name: "Android",
      icon: "fab fa-android",
      requires: t("Android 7.0 or later")
    },
    ios: {
      name: "iOS",
      icon: "fab fa-apple",
      requires: t("iOS 15 or later")
    }
  };

  //- One line per distribution channel in config/mail-app-channels.js, keyed
  //- by its `key`: what installing through it gets you, shown beside a live
  //- channel's command or link. A channel with no entry renders its name
  //- alone, so a new channel still works before it has copy here.
  const channelNotes = {
    homebrew: t("Updates with brew upgrade"),
    "mac-app-store": t("Updates through the App Store"),
    winget: t("Updates with winget upgrade"),
    "microsoft-store": t("Updates through the Microsoft Store"),
    "snap-store": t("Updates through snapd"),
    "google-play": t("Updates through Google Play"),
    obtainium: t("Paste as the app source in Obtainium and it tracks every release"),
    "fdroid-repo": t("Add the repository to your F-Droid client"),
    "app-store": t("Updates through the App Store")
  };

//- A copy-to-clipboard control for a checksum, key, command or fingerprint.
//- Wired up by js/download.js, which reads data-fe-copy; until then it is
//- inert, which is why it only ever sits next to a value that is also shown
//- in full.
mixin feDownloadCopy(value, label)
  button.fe-download-copy(type="button", data-fe-copy=value, aria-label=label)
    i.fa.fa-clipboard(aria-hidden="true")
    span.fe-download-copy__done(aria-hidden="true")
      i.fa.fa-check
