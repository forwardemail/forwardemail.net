//- Redesigned landing hero, per section 2 of the landing page build spec.
//- Dark surface, two columns at >=1024px, routing console on the right.
//- Replaced the #freddy starfield, which pricing.pug has since dropped too, so
//- nothing renders it any more.
mixin feHero
  section.fe-section.fe-surface-dark.fe-section--hero.fe-hero(
    aria-labelledby="fe-hero-title"
  )
    .fe-container.fe-hero__inner
      .fe-hero__grid
        div
          //- Eyebrow
          p.fe-hero__eyebrow.fe-eyebrow.fe-label
            i.fab.fa-github(aria-hidden="true")
            = t("100% open-source email infrastructure")

          //- The headline and lede are the ones the previous home page
          //- carried (already translated in all 25 locales), one headline
          //- at every width rather than the wide / narrow pair.
          h1#fe-hero-title.fe-display-xl.fe-hero__title!= t("All-in-one Email Solution")

          p.fe-lede.fe-hero__body!= t("Privacy-focused email hosting, forwarding, newsletters, and API")

          .fe-actions.fe-actions--start
            a.fe-btn.fe-btn--hero.fe-btn--lg.fe-btn--glow(href=l("/register"))
              = t("Start free")
              i.fa.fa-angle-right(aria-hidden="true")
            button.fe-btn.fe-btn--ghost.fe-btn--lg(
              type="button",
              data-toggle="modal",
              data-target="#modal-domain-search"
            )
              i.fa.fa-search(aria-hidden="true")
              = t("Check a domain")

          //- Outbound SMTP is unlimited and reputation-based on paid plans
          a.fe-chip.fe-hero__offer(
            href=l("/faq#can-i-send-unlimited-emails-with-this")
          )
            i.fa.fa-paper-plane.fe-chip__icon--success(aria-hidden="true")
            = t("Unlimited outbound email from $%d/mo", planPricing.enhanced)

          .fe-hero__trust
            p.fe-hero__trust-label.fe-label= t("Trusted by 1.6M+ domains")
            ul.fe-hero__logos
              li Netflix Games
              li Disney
              li The Linux Foundation
              li Ubuntu

        //- Right column. The console renders all six of its views on every
        //- request and condenses at narrow widths rather than being swapped for
        //- separate markup. One DOM means a phone visitor gets the same message
        //- the desktop does, and there is only one thing to keep true.
        div
          +feConsole

//- +feConsole and the six views it renders now live in _fe-console.pug, which
//- home.pug includes ahead of this file. The single delivery-path graphic that
//- used to sit here was replaced by that tab rail: the console can only show
//- one thing at a time, and six switchable views carry considerably more of
//- the platform than one static diagram did.
