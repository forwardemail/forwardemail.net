extends layout

block append scripts
  //- domain-search.js, hero-console.js and video-modal.js in one file (see
  //- bundle() in gulpfile.js)
  +script("js/home.js")

block body
  //- Inlined by pug, so feConsoleViews and the +feConsole mixin are in scope
  //- for _fe-hero below, which renders the console into the hero's right column.
  include _fe-console
  include _fe-hero
  include _fe-product
  include _fe-pricing
  include _fe-testimonials
  include _modal-domain-search
  +modalDomainSearch
  //- The tour video, opened from the hero and the product section
  include _fe-video
  +feVideoModal
  //- The flush modifier pulls the hero up under the transparent fixed navbar.
  //- It is a separate class from .fe-landing because /download shares that
  //- wrapper but must not pull up when a signed in visitor gets the opaque bar.
  .fe-landing(class=isFeHeroUnderBar ? "fe-landing--flush" : "")
    +feHero
    +feProduct
    +fePricing
    //- Replaces the legacy _testimonials parallax and its "Happy Customers"
    //- bounce anchor; the section keeps id="testimonials" so old deep links
    //- still resolve. The legacy partial is untouched and still rendered by
    //- pricing.pug, compare.pug and open-source.pug.
    +feTestimonials

  //- _marketing was dropped from this page rather than kept below the new
  //- sections. Its "All-inclusive features / No additional fees for must-have
  //- features" pitch is the same one the product section now makes, so
  //- rendering both would put duplicate content on the page. The partial is
  //- untouched and still rendered by pricing.pug, open-source.pug and
  //- compare.pug, so nothing else loses that copy.
  include _tti
