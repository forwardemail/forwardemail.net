      else
        - const isTrustpilotEligibleUser = user && user.created_at && dayjs(user.created_at).add(3, "month").isBefore(dayjs());
        - const hasOnlyGoodDomains = typeof domains !== "undefined" && Array.isArray(domains) && domains.length > 0 && domains.every((userDomain) => typeof userDomain.name === "string" && config.goodDomains.some((ext) => userDomain.name.toLowerCase().endsWith(`.${ext}`)));
