extends ../layout

include ../_fe-page-header
include ../_fe-cards

block body
  //- Was: bootstrap cards on the stars parallax, with the video / GIF
  //- badges in the corner. Same list, same order, same media, on the fe
  //- page header and the shared card grid.
  - const providers = [...nsProviders];
  - providers.unshift({ name: "Send Mail As with Gmail", slug: "send-mail-as-gmail-custom-domain", video: "https://youtu.be/MEheS8gM4Xs" });
  - providers.unshift({ name: "Send Email with Custom Domain", slug: "send-email-with-custom-domain-smtp" });
  .fe-landing(class=isFeFlushNav ? "fe-landing--flush" : "")
    +fePageHeader({ id: "fe-guides", icon: "fa fa-book", eyebrow: t("Setup guides"), title: t("Free Email Forwarding and Hosting Setup Guides"), body: t("Listed below are setup guides for email forwarding and hosting.") })
      .fe-page-header__meta
        +feByline
    section.fe-section.fe-surface-light.fe-section--pad-sm.fe-body.no-search
      .fe-container
        ul.fe-grid.fe-grid--md-2.fe-grid--lg-3
          each provider, i in providers
            - const str = t('How to Setup Email with <span class="notranslate">%s</span>', provider.name);
            - const str2 = t('<span class="notranslate">%s</span> Email Setup Tutorial', provider.name);
            - const description = provider.video ? t('Send and receive emails with <span class="notranslate">%s</span> and setup free email forwarding for <span class="notranslate">%s</span> with video and step by step instructions.', provider.name, provider.name) : t('Send and receive emails with <span class="notranslate">%s</span> and setup free email forwarding for <span class="notranslate">%s</span> with step by step instructions.', provider.name, provider.name);
            +feCard({ title: provider.name, subtitle: str2, description, href: l(`/guides/${provider.slug}`), alt: striptags(str), image: l(`/guides/${provider.slug}.png`), video: provider.gif, eager: i <= 1, badgeVideo: Boolean(provider.video), badgeGif: Boolean(provider.gif), cta: t("Read tutorial") })
        //- Disclaimer
        if !isBotUa
          p.fe-disclaimer
            strong= t("Notice of Non-Affiliation and Disclaimer:")
            = " "
            != t('We are not affiliated, associated, authorized, endorsed by, or in any way officially connected with <span class="notranslate">%s</span>, or any of its subsidiaries or its affiliates. The name <span class="notranslate">%s</span> as well as related names, marks, emblems, and images are registered trademarks of their respective owners.', arrayJoinConjunction(nsProviders.map((p) => p.name)), arrayJoinConjunction(nsProviders.map((p) => p.name)))
