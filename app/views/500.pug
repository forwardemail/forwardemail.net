extends layout

include _fe-page-header

block body
  //- Dark, centred, one action, on the shared status mixin. Title and
  //- description come from meta, as before. The article illustration this
  //- page used to show is hidden site-wide for now.
  .fe-landing
    +feStatus("500", meta.title, meta.description)
      form(action=ctx.path, method="GET")
        button.fe-btn.fe-btn--hero.fe-btn--lg(type="submit")
          i.fa.fa-redo(aria-hidden="true")
          = t("Try again")
      a.fe-btn.fe-btn--ghost.fe-btn--lg(href=l("/help"))
        i.fa.fa-envelope(aria-hidden="true")
        = t("Contact support")
