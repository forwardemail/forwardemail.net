//- Pug makes it DOCTYPE if we do this:
//- `doctype html`
!= "<!doctype html>"
- const isNotPrivateRoute = ["/my-account", "/admin", "/verify", "/denylist", "/forgot-password", "/reset-password", "/help", "/auth", "/register", config.loginOtpRoute, config.loginRoute, config.verifyRoute, config.otpRoutePrefix].every((s) => !ctx.pathWithoutLocale.startsWith(s));
html.h-100.no-js(
  lang=locale,
  dir=["ar", "he"].includes(locale) ? "rtl" : false
)
  head
    block meta
      include _meta
    block opengraph
      include _opengraph
    block fonts
      include _fonts
    block stylesheets
      //- Scalar is themed onto the fe palette in _scalar-theme.scss.
      link(
        rel="stylesheet",
        href=manifest("css/app.css"),
        integrity=manifest("css/app.css", "integrity"),
        fetchpriority="high",
        crossorigin="anonymous"
      )
  body(role="document")
    //- _nav.pug reads the fe gates; this page bypasses layout.pug, so it
    //- includes them itself.
    include _fe-flags
    include _nav
    //- Visually-hidden h1 for SEO and accessibility.
    //- The visible "Email API" heading is rendered client-side by the
    //- Scalar API reference widget into #app, so the server-rendered HTML
    //- has no h1 for crawlers or assistive technology. This sr-only
    //- heading provides one without affecting the visual layout.
    h1.sr-only= t("Email API for Developers")
    //- "Use my API token", placed in the reference's Authentication card by the
    //- script below. The token is not in the page: the button fetches it when
    //- used and fills it into the card (and the examples); it is cleared again
    //- when clicked, after a while, or when the tab goes to the background
    //- (see assets/js/api-token.js). Nothing for a disabled token.
    if user && !user[config.userFields.apiTokenDisabled]
      #api-token-use.fe-api-token-use(
        hidden,
        data-api-token,
        data-api-token-url=l("/my-account/security/api-token"),
        data-show-label=t("Use my API token"),
        data-hide-label=t("Clear my API token")
      )
        button(type="button", aria-pressed="false", data-api-token-toggle)
          i.fa.fa-key
          = " "
          span(data-api-token-toggle-label)= t("Use my API token")
    .scalar-app-reset
      #app
    include _footer

    //- scripts (mirrored from layout.pug block scripts)
    //- flash messaging (with koa-better-flash and sweetalert2)
    script(defer, nonce=nonce).
      window._types = {
        success: "#{ t('Success') }",
        error: "#{ t('Error') }",
        info: "#{ t('Info') }",
        warning: "#{ t('Warning') }",
        question: "#{ t('Question') }",
      };
    //- prettier-ignore
    script#flash-messages(defer, nonce=nonce, data-ignore-hash-change).
      window._messages = !{json(flash(), null, null)};
    //- set defaults for sweetalert2
    //- <https://github.com/limonte/sweetalert2/issues/763>
    script(defer, nonce=nonce).
      window._swalDefaults = {
        confirmButtonText: "#{ t('OK') }",
        cancelButtonText: "#{ t('Cancel') }",
        closeButtonAriaLabel: "#{ t('Close this dialog') }",
        reverseButtons: true,
      };

    //- set defaults for confirm prompt sweetalert2 modal
    script(defer, nonce=nonce).
      window._confirmPromptTitle = "#{ t('Are you sure?') }";
      window._confirmPromptHTML = "#{ t('Please confirm if you wish to continue.') }";

    //- set the locale to be used by front-end assets
    script(defer, nonce=nonce).
      window.LOCALE = "#{locale}";

    //- set the API endpoint to be used by front-end assets
    script(defer, nonce=nonce).
      window.API_URL = "#{config.urls.api}";

    //- set the user to be used by CabinJS
    if config.env !== 'test'
      if user
        script(defer, nonce=nonce).
          window.USER = {
            id: !{json(user.id)},
            name: !{json(user[config.passport.fields.displayName])},
            email: !{json(user.email)},
          };
      else if ctx.sessionId
        script(defer, nonce=nonce).
          window.USER = {
            id: "#{ctx.sessionId}",
          };

    //- build, which ends with the WebMCP tools (see layout.pug)
    script(
      nonce=nonce,
      defer,
      src=manifest("js/build.js"),
      integrity=manifest("js/build.js", "integrity"),
      crossorigin="anonymous",
      fetchpriority="low",
      data-locale=locale,
      data-pricing=Object.keys(planPricing)
        .map((k) => `${k}:${Number(planPricing[k])}`)
        .join(",")
    )

    //- cloudflare turnstile (hidden from bots and admins)
    if config.turnstileEnabled && (!user || user.group !== 'admin')
      script(defer, nonce=nonce).
        window.TURNSTILE_RENDER_ERROR = "#{ t('Turnstile render error, please try again or contact us.') }";
        window.TURNSTILE_SITE_KEY = "#{ config.turnstileSiteKey }";
      script(
        nonce=nonce,
        defer,
        src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback"
      )

    //- scalar API reference
    script(nonce=nonce, src="/js/scalar.js", crossorigin="anonymous")
    - const API_SPEC = `${config.urls.web}/api-spec${locale === "en" ? "" : "-" + locale}.json`;
    script(nonce=nonce).
      window.API_URL = "#{config.urls.api}";
      window.WEB_URL = "#{config.urls.web}";
      window.OG_IMAGE = "#{ogImage}";
      window.SITE_NAME = "#{config.appName}";
      window.TITLE = "#{meta.title}";
      window.DESCRIPTION = "#{meta.description}";

      // The site follows the system light/dark setting and has no toggle of
      // its own, so the reference does too: drop a choice left by the toggle
      // Scalar used to show, and hide that toggle.
      try {
        window.localStorage.removeItem("colorMode");
      } catch {}

      // The token is filled in only while "Use my API token" is on
      function authentication(token) {
        return {
          preferredSecurityScheme: "ApiKeyAuth",
          securitySchemes: {
            ApiKeyAuth: {
              username: token,
              password: "",
            },
            AliasAuth: {
              name: "Authorization",
              in: "header",
              value: token,
            },
          },
        };
      }

      const referenceOptions = {
        withDefaultFonts: false,
        servers: [
          {
            url: window.API_URL,
          },
        ],
        url: "#{API_SPEC}",
        favicon: "/img/favicon.svg",
        metaData: {
          title: window.TITLE,
          ogTitle: window.TITLE,
          description: window.DESCRIPTION,
          ogDescription: window.DESCRIPTION,
          ogImage: window.OG_IMAGE,
          siteName: window.SITE_NAME,
        },
        hideClientButton: true,
        hideDarkModeToggle: true,
        // never save the token in browser storage (the default today)
        persistAuth: false,
      };

      const apiReference = Scalar.createApiReference("#app", {
        ...referenceOptions,
        authentication: authentication(""),
      });

      document.addEventListener("api-token:change", function (event) {
        apiReference.updateConfiguration({
          ...referenceOptions,
          authentication: authentication(event.detail.token),
        });
      });

      // Put "Use my API token" at the foot of the Authentication card, and
      // back again whenever the reference redraws the card. It stays hidden
      // if the card is never found.
      (function () {
        const control = document.getElementById("api-token-use");
        const app = document.getElementById("app");
        if (!control || !app) return;
        function place() {
          const card = app.querySelector(".scalar-reference-intro-auth");
          if (!card || control.parentElement === card) return;
          card.append(control);
          control.hidden = false;
        }

        new MutationObserver(place).observe(app, {
          childList: true,
          subtree: true,
        });
        place();
      })();

    include _wikipedia
