//- Outbound SMTP reputation card
//- (shown on My Account → Billing and My Account → Emails)
//- expects `smtpReputation` from `helpers/get-smtp-reputation-summary.js`
mixin smtpReputationCard(smtpReputation)
  .card.border-themed.h-100
    h2.h6.card-header= t("Outbound SMTP Reputation")
    .card-body
      p.small.text-muted
        != t('Outbound SMTP is unlimited, and your daily threshold grows with your sender reputation. <a href="%s" target="_blank">Learn more</a>.', l("/faq#what-are-your-outbound-smtp-limits"))
      if smtpReputation.isRestricted
        .alert.alert-danger.small
          = t("Our team limited your outbound SMTP. Contact us if you think this is a mistake.")
      if smtpReputation.holdUntil
        .alert.alert-danger.small
          if smtpReputation.holdReason === "bounces"
            != t('We paused moving up to a higher tier until <span class="notranslate">%s</span> because of a high bounce rate.', dayjs(smtpReputation.holdUntil).locale(locale).format("LL"))
          else
            != t('We paused moving up to a higher tier until <span class="notranslate">%s</span> because of spam or virus reports about your mail.', dayjs(smtpReputation.holdUntil).locale(locale).format("LL"))
      if smtpReputation.lendHoldUntil
        .alert.alert-warning.small
          != t('Members of your Team plan domains cannot use your threshold until <span class="notranslate">%s</span> because of spam or virus reports about their mail. Your own sending stays the same.', dayjs(smtpReputation.lendHoldUntil).locale(locale).format("LL"))
      if smtpReputation.isRecentlyThrottled
        .alert.alert-warning.small
          = t("We slowed down your sending in the last 24 hours because of an unusual sending pattern. It speeds back up as your activity returns to normal.")
      dl.row.mb-0
        dt.col-sm-7= t("Daily threshold")
        dd.col-sm-5.notranslate
          = smtpReputation.threshold.toLocaleString(locale)
          = " "
          span.translate= t("per day")
        if smtpReputation.teamThreshold > 0
          dt.col-sm-7= t("Team domain threshold (highest admin)")
          dd.col-sm-5.notranslate
            = smtpReputation.teamThreshold.toLocaleString(locale)
            = " "
            span.translate= t("per day")
        if smtpReputation.manualFloor > 0
          dt.col-sm-7= t("Approved minimum (set by our team)")
          dd.col-sm-5.notranslate
            = smtpReputation.manualFloor.toLocaleString(locale)
            = " "
            span.translate= t("per day")
        dt.col-sm-7= t("Reputation tier")
        dd.col-sm-5.notranslate= `${smtpReputation.tier} / ${smtpReputation.tierCount}`
        dt.col-sm-7= t("Paying without a break (days)")
        dd.col-sm-5.notranslate= smtpReputation.paidDays.toLocaleString(locale)
        dt.col-sm-7= t("Clean sending days on this tier")
        dd.col-sm-5.notranslate= smtpReputation.cleanDays.toLocaleString(locale)
        dt.col-sm-7!= t('Busiest day in the last <span class="notranslate">%d</span> days (recipients outside your domains)', smtpReputation.lookbackDays)
        dd.col-sm-5.notranslate= smtpReputation.peak.toLocaleString(locale)
        dt.col-sm-7= t("Most recipient domains on a day")
        dd.col-sm-5.notranslate= smtpReputation.peakDomains.toLocaleString(locale)
      if smtpReputation.next
        hr
        p.mb-2
          strong!= t('Next tier: <span class="notranslate">%s</span> per day', smtpReputation.next.limit.toLocaleString(locale))
        ul.list-unstyled.small.mb-0
          li
            i.fa.fa-fw(
              class=smtpReputation.next.hasPaidDays ? "fa-check-circle text-success" : "fa-circle text-muted",
              aria-hidden="true"
            )
            = " "
            != t('Paying without a break for <span class="notranslate">%d</span> days', smtpReputation.next.minPaidDays)
          li
            i.fa.fa-fw(
              class=smtpReputation.next.hasCleanDays ? "fa-check-circle text-success" : "fa-circle text-muted",
              aria-hidden="true"
            )
            = " "
            != t('<span class="notranslate">%d</span> clean sending days on this tier', smtpReputation.next.minCleanDays)
          li
            i.fa.fa-fw(
              class=smtpReputation.next.hasPeak ? "fa-check-circle text-success" : "fa-circle text-muted",
              aria-hidden="true"
            )
            = " "
            != t('Reach at least <span class="notranslate">%d</span> recipients outside your own domains in a single day', smtpReputation.next.neededPeak)
          if smtpReputation.next.minRecipientDomains > 0
            li
              i.fa.fa-fw(
                class=smtpReputation.next.hasRecipientDomains ? "fa-check-circle text-success" : "fa-circle text-muted",
                aria-hidden="true"
              )
              = " "
              != t('Reach at least <span class="notranslate">%d</span> different recipient domains in a single day', smtpReputation.next.minRecipientDomains)
      else if smtpReputation.isTopTier && !smtpReputation.isRestricted
        hr
        p.small.mb-0= t("You have reached the highest automatic tier. Our team reviews further increases, with no action needed from you.")
