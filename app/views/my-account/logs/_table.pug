include ../../_sort-header
include ../../_pagination
include ../_list-filters

.table-responsive
  table#table-logs.table.table-hover.table-bordered.table-sm
    thead.thead-dark
      tr
        th.text-center.align-middle(scope="col")
          +sortHeader("created_at", "Date", "#table-logs")
        th.text-center.align-middle(scope="col")= t("Log")
        th.text-center.align-middle.d-none.d-md-table-cell(scope="col")
          +sortHeader("meta.info.messageSize", "Size", "#table-logs")
        th.text-center.align-middle.d-none.d-lg-table-cell(scope="col")
          +sortHeader("meta.info.deliveryTime", "Delivery Time", "#table-logs")
        th.text-center.align-middle(scope="col")
          +sortHeader("err.responseCode", "Status", "#table-logs")
        th.text-center.align-middle(scope="col")= t("Actions")
    tbody
      if logs.length === 0
        tr
          td.alert.alert-info(colspan="6")
            //- FIX: Context-aware empty state messages
            //- Show specific messages based on which filters are active
            if activeFilters && activeFilters.hasSearch
              = t("No logs found matching your search.")
            else if activeFilters && activeFilters.hasResponseCodes
              = t("No logs found for the selected response code.")
            else if activeFilters && activeFilters.hasBounceCategory
              = t("No logs found for the selected bounce category.")
            else if activeFilters && activeFilters.hasDateRange
              = t("No logs found for the selected date range.")
            else if activeFilters && activeFilters.hasShowErrors
              = t("No error logs found for the current filters.")
            else if activeFilters && activeFilters.hasDomainFilter
              = t("No logs found for the selected domain.")
            else if hideItemCount
              //- This case: itemCount > 0 but logs.length === 0 after privacy filtering
              = t("No logs available on this page. This may occur due to privacy filtering. Try adjusting your filters or navigating to a different page.")
            else if hasAnyFilter
              = t("No logs found for the selected filters.")
            else
              = t("No error logs have been stored yet. Please check back later.")
      else
        each log in logs
          - const deliveryMs = log.meta && log.meta.info ? (log.meta.info.envelopeTime || 0) + (log.meta.info.messageTime || 0) : 0;
          - const msgSize = log.meta && log.meta.info && log.meta.info.messageSize ? log.meta.info.messageSize : 0;
          -
            const rcptAddrs = log.meta && log.meta.session && log.meta.session.envelope && log.meta.session.envelope.rcptTo && _.isArray(log.meta.session.envelope.rcptTo) ? log.meta.session.envelope.rcptTo.map(r => r.address) : [];
          -
            const infoDestAddrs = log.meta && log.meta.info && log.meta.info.envelope && log.meta.info.envelope.to && _.isArray(log.meta.info.envelope.to) && !_.isEmpty(log.meta.info.envelope.to) ? log.meta.info.envelope.to : (log.meta && log.meta.info && log.meta.info.accepted && _.isArray(log.meta.info.accepted) && !_.isEmpty(log.meta.info.accepted) ? log.meta.info.accepted : []);
          -
            const destAddrs = infoDestAddrs.length > 0 ? infoDestAddrs : (log.message === 'delivered' && rcptAddrs.length > 0 ? rcptAddrs : []);
          -
            const isForwarded = infoDestAddrs.length > 0 && rcptAddrs.length > 0 && !infoDestAddrs.every(d => rcptAddrs.includes(d));
          - const destLabel = isForwarded ? "Forwarded To" : "Delivered To";
          tr
            //- Date column
            td.align-middle.text-nowrap
              small.text-monospace
                if log.meta && log.meta.session && log.meta.session.arrivalDate
                  span.dayjs(
                    data-time=new Date(log.meta.session.arrivalDate).getTime()
                  )= dayjs(log.meta.session.arrivalDate).tz(user.timezone === 'Etc/Unknown' ? 'UTC' : user.timezone).format("M/D/YY h:mm A z")
                else
                  span.dayjs(data-time=new Date(log.created_at).getTime())= dayjs(log.created_at).tz(user.timezone === 'Etc/Unknown' ? 'UTC' : user.timezone).format("M/D/YY h:mm A z")
            //- Log details column
            td.align-middle
              ul.list-unstyled.mb-0
                li
                  span.badge.badge-pill.badge-dark= t("ID")
                  = " "
                  span.small: code= log.id
                //- MAIL FROM
                if log.meta && log.meta.session && log.meta.session.envelope && log.meta.session.envelope.mailFrom && log.meta.session.envelope.mailFrom.address
                  li
                    span.badge.badge-pill.badge-dark= t("MAIL FROM")
                    = " "
                    a.small(
                      href=getFilterUrl({ q: log.meta.session.envelope.mailFrom.address })
                    ): code= log.meta.session.envelope.mailFrom.address
                //- RCPT TO
                if log.meta && log.meta.session && log.meta.session.envelope && log.meta.session.envelope.rcptTo && _.isArray(log.meta.session.envelope.rcptTo) && !_.isEmpty(log.meta.session.envelope.rcptTo)
                  li
                    span.badge.badge-pill.badge-dark= t("RCPT TO")
                    = " "
                    ul.list-inline.d-inline-block.mb-0
                      each rcpt in log.meta.session.envelope.rcptTo
                        li.list-inline-item
                          a.small(href=getFilterUrl({ q: rcpt.address })): code= rcpt.address
                //- Delivered To / Forwarded To (destination)
                if destAddrs.length > 0
                  li
                    span.badge.badge-pill.badge-success= t(destLabel)
                    = " "
                    ul.list-inline.d-inline-block.mb-0
                      each recipient in destAddrs
                        li.list-inline-item
                          small: code= recipient
                //- From Header
                if log.meta && log.meta.session && log.meta.session.originalFromAddress
                  li
                    span.badge.badge-pill.badge-primary= t("From")
                    = " "
                    a.small(
                      href=getFilterUrl({ q: log.meta.session.originalFromAddress })
                    ): code= log.meta.session.originalFromAddress
                else if log.meta && log.meta.session && log.meta.session.headers && log.meta.session.headers.From
                  li
                    span.badge.badge-pill.badge-primary= t("From")
                    = " "
                    span.small: code= log.meta.session.headers.From
                //- Subject Header
                if log.meta && log.meta.session && log.meta.session.headers && log.meta.session.headers.Subject
                  li
                    span.badge.badge-pill.badge-primary= t("Subject")
                    = " "
                    span.small: code= log.meta.session.headers.Subject
                //- Message Size and Delivery Time (on small screens, as their
                //- columns are not shown)
                if msgSize > 0
                  li.d-md-none
                    span.badge.badge-pill.badge-secondary
                      i.fa.fa-file.mr-1
                      if msgSize >= 1048576
                        | #{ (msgSize / 1048576).toFixed(1) } MB
                      else if msgSize >= 1024
                        | #{ (msgSize / 1024).toFixed(0) } KB
                      else
                        | #{ msgSize } B
                if deliveryMs > 0
                  li.d-lg-none
                    i.fa.fa-clock.mr-1
                    +deliveryTime(deliveryMs)
            //- Message Size column (hidden on small screens)
            td.align-middle.text-center.text-nowrap.d-none.d-md-table-cell
              if msgSize > 0
                small.text-monospace
                  if msgSize >= 1048576
                    | #{ (msgSize / 1048576).toFixed(1) } MB
                  else if msgSize >= 1024
                    | #{ (msgSize / 1024).toFixed(0) } KB
                  else
                    | #{ msgSize } B
              else
                small.text-muted= "—"
            //- Delivery Time column (hidden on small/medium screens)
            td.align-middle.text-center.text-nowrap.d-none.d-lg-table-cell
              +deliveryTime(deliveryMs)
            //- Status column
            td.align-middle.small
              -
                const isWebhook = Boolean(log.meta && log.meta.is_webhook === true);
                let statusCode;
                if (log.err && log.err.responseCode) statusCode = log.err.responseCode;
                else if (log.err && log.err.statusCode) statusCode = log.err.statusCode;
                else if (log.err && log.err.status) statusCode = log.err.status;
                else if (log.message === "delivered") statusCode = 250;
                // (webhooks have a `200` status code)
                if (isWebhook) statusCode = 200;
                // (a code the list can be filtered by, see list-logs.js)
                const isFilterable = isResponseCode(statusCode) && (log.message === "delivered" ? statusCode === (isWebhook ? 200 : 250) : !isWebhook && Boolean(log.err) && statusCode === log.err.responseCode);
              if log.meta && statusCode
                +responseCodeBadge(statusCode, isFilterable ? getFilterUrl({ response_codes: statusCode, response_code: undefined }) : undefined)
                = " "
              if isSANB(log.bounce_category) && log.bounce_category !== "none"
                a.badge.badge-pill.badge-dark(
                  href=getFilterUrl({ bounce_category: log.bounce_category })
                )= log.bounce_category === "dmarc" ? "DMARC" : titleize(humanize(log.bounce_category))
              .mt-1
                small.text-monospace
                  if log.err && log.err.envelope && log.err.envelope.to && typeof log.err.envelope.to === 'string'
                    = "("
                    = log.err.envelope.to
                    = ")"
                    = " "
                  if log.err && log.err.isCodeBug === true
                    = t("An unexpected internal server error has occurred")
                  else if log.message === "delivered"
                    if log.meta && log.meta.info && log.meta.info.pgp === true
                      = "("
                      = t("PGP Encrypted")
                      = ")"
                      = " "
                    if log.meta && log.meta.is_webhook && log.meta.is_webhook === true
                      = "("
                      = t("Webhook")
                      = ")"
                      = " "
                      //- Show webhook response details if available
                      if log.meta.webhook_log
                        br
                        small.text-muted
                          i.fa.fa-check-circle.mr-1
                          = t("Status:")
                          = " "
                          span.badge.badge-success= log.meta.webhook_log.status_code
                    //- TODO: log more details from `log.info`, e.g. EHLO etc
                    if log.meta && log.meta.info && log.meta.info.response
                      != safeAnsiHTML(log.meta.info.response)
                    else
                      != safeAnsiHTML(log.message)
                  else
                    != log.err && log.err.message ? safeAnsiHTML(log.err.message) : safeAnsiHTML(log.message)
                //- Show error source attribution with fallback logic
                if log.err
                  br
                  small.text-muted
                    i.fa.fa-server.mr-1
                    = t("Error from:")
                    = " "
                    if log.err.truthSource
                      span.badge.badge-info= log.err.truthSource
                    else if log.err.target
                      span.badge.badge-info= log.err.target
                    else if log.err.name === 'DenylistError'
                      span.badge.badge-secondary= "Forward Email"
                    else if log.err.code
                      span.badge.badge-secondary= "Forward Email"
                    else
                      span.badge.badge-secondary= "Forward Email"
                  //- Show webhook error details if available
                  if log.err.webhook_log
                    br
                    small.text-muted
                      i.fa.fa-globe.mr-1
                      = t("Webhook:")
                      = " "
                      if log.err.webhook_log.status_code
                        span.badge.badge-warning= log.err.webhook_log.status_code
                        = " "
                      if log.err.webhook_log.error_code
                        span.badge.badge-danger= log.err.webhook_log.error_code
                  //- Show bounce reason if available
                  if log.err && log.err.bounceInfo && log.err.bounceInfo.message && log.err.bounceInfo.message !== 'Unknown'
                    br
                    small.text-muted
                      i.fa.fa-info-circle.mr-1
                      = t("Reason:")
                      = " "
                      span= log.err.bounceInfo.message
                if log.err && !log.err.isCodeBug && log.err.bounces && log.err.bounces.length > 0
                  ul
                    each bounce in log.err.bounces
                      li
                        span.badge.badge-dark.mr-1= bounce.address
                        i.fa.fa-angle-right.mr-1
                        if bounce.recipient && bounce.recipient.to
                          if Array.isArray(bounce.recipient.to)
                            each to in bounce.recipient.to
                              span.badge.badge-danger.mr-1= to
                          else
                            span.badge.badge-danger.mr-1= bounce.recipient.to
                        if bounce.err && bounce.err.message
                          span.text-monospace!= safeAnsiHTML(bounce.err.message)

                        br

                        //- status code
                        - let specificStatusCode;
                        - let specificBadgeClass = "badge-success";
                        if bounce.err && bounce.err.statusCode
                          - specificStatusCode = bounce.err.statusCode;
                        else if bounce.err && bounce.err.status
                          - specificStatusCode = bounce.err.status;
                        else if bounce.err && bounce.err.responseCode
                          - specificStatusCode = bounce.err.responseCode;

                        if specificStatusCode
                          if specificStatusCode >= 500
                            - specificBadgeClass = "badge-danger";
                          else if specificStatusCode >= 400
                            - specificBadgeClass = "badge-warning";
                          else if specificStatusCode >= 300
                            - specificBadgeClass = "badge-primary";
                          span.badge.badge-pill.mr-1(class=specificBadgeClass)= specificStatusCode

                        //- message
                        if bounce.err && bounce.err.original_message
                          span.text-monospace.mr-1= bounce.err.original_message
            //- Actions column
            td.align-middle.text-center
              ul.list-inline.mb-0
                li.list-inline-item
                  a.btn.btn-dark.btn-sm(
                    href=l(`/my-account/logs/${log.id}`),
                    target="_blank"
                  )
                    = t("View Details")
                if log.email
                  li.list-inline-item
                    a.btn.btn-primary.btn-sm(
                      href=l(`/my-account/emails/${log.email.toString()}`),
                      target="_blank"
                    )
                      = t("View Email")
                //- One-click unsubscribe (RFC 8058), see retrieve-log-unsubscribe.js
                if getOneClickUnsubscribeUrl(log)
                  li.list-inline-item
                    a.btn.btn-danger.btn-sm(
                      href=l(`/my-account/logs/${log.id}/unsubscribe`),
                      target="_blank"
                    )
                      = t("Unsubscribe")
                if log.err && log.err.name === 'DenylistError'
                  //- `log.err` is a Mixed field, so `log.err.message` may be
                  //- missing or non-string (e.g. for sanitized/oversized logs).
                  //- Guard before calling `.split()` to avoid throwing a
                  //- TypeError during render, which would surface as an
                  //- uncaptured "Internal Server Error" on the entire Logs page.
                  - let href = typeof log.err.message === "string" ? log.err.message.split("you must visit ")[1] : undefined;
                  if href
                    - href = href.split(";")[0].trim();
                  if href && href.startsWith('https://forwardemail.net/denylist?q=')
                    li.list-inline-item
                      a.btn.btn-warning.btn-sm(href=href, target="_blank")
                        = t("Request Removal")
+paginate('#table-logs')
