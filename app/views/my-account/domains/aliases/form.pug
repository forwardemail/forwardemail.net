extends ../../../layout

block body
  include ../_modal-domain
  //- include ../_modal-openpgp-example
  .container.pt-3
    .row
      .col
        include ../../../_breadcrumbs
  .container.py-3
    .row
      .col
        .card.border-themed
          .card-body
            form.ajax-form(action=ctx.path, method="POST")
              include _form
              button.btn.btn-success.btn-block.btn-lg(type="submit")
                if alias
                  = t("Update Mailbox")
                else
                  = t("Create Mailbox")
    //- Recent sign-ins (see helpers/alias-sign-ins.js)
    if alias && Array.isArray(signIns) && alias.name !== "*" && !alias.name.startsWith("/")
      - const signInServices = { smtp: "SMTP", imap: "IMAP", pop3: "POP3", caldav: "CalDAV", carddav: "CardDAV", api: "API", managesieve: "ManageSieve" };
      .row.mt-3
        .col
          #recent-sign-ins.card.border-themed
            h2.card-header.h6.font-weight-bold= t("Recent Sign-Ins")
            .card-body
              p.small.text-muted
                = t("The IP addresses this alias was signed in from in the last 7 days, with the latest sign-in from each one.")
                = " "
                = t("If you do not recognize one, generate a new password for this alias.")
              if signIns.length === 0
                p.mb-0= t("This alias was not signed in to in the last 7 days.")
              else
                .table-responsive
                  table.table.table-sm.table-bordered.table-hover.mb-0
                    thead.thead-dark
                      tr
                        th(scope="col")= t("Service")
                        th(scope="col")= t("IP Address")
                        th(scope="col")= t("Latest Sign-In")
                    tbody
                      each signIn in signIns
                        tr
                          td.align-middle
                            span.badge.badge-dark.notranslate= signInServices[signIn.service] || signIn.service
                          td.align-middle.text-break
                            code= signIn.remote_address
                            if getIPLookupUrl(signIn.remote_address)
                              = " "
                              a.text-muted(
                                href=getIPLookupUrl(signIn.remote_address),
                                target="_blank",
                                rel="noopener noreferrer",
                                title=t("Look up on Cloudflare Radar")
                              ): i.fa.fa-globe
                          td.align-middle.text-nowrap
                            span.dayjs(data-time=signIn.date.getTime())= dayjs(signIn.date).tz(user.timezone === 'Etc/Unknown' ? 'UTC' : user.timezone).format("M/D/YY h:mm A z")
    if alias && Array.isArray(arfBlocks) && arfBlocks.length > 0
      .row.mt-3
        .col
          .card.border-themed
            .card-body
              h2.h5= t("Senders blocked after spam reports")
              p.text-muted= t("The recipient at these forwarding addresses reported mail from these senders as spam to their mailbox provider, so their mail to that address gets a temporary error until the date shown.")
              .table-responsive
                table.table.table-sm.table-bordered.mb-0
                  thead
                    tr
                      th(scope="col")= t("Sender")
                      th(scope="col")= t("Forwarding address")
                      th(scope="col")= t("Until")
                      th.text-center(scope="col")= t("Unblock")
                  tbody
                    each block in arfBlocks
                      tr
                        td.align-middle
                          code.notranslate= block.sender
                        td.align-middle
                          code.notranslate= block.destination
                        td.align-middle.notranslate= dayjs(block.until).locale(locale).format("LL")
                        td.align-middle.text-center
                          form.ajax-form.confirm-prompt.d-inline-block(
                            action=l(`/my-account/domains/${punycode.toASCII(domain.name)}/aliases/${alias.id}/unblock-sender`),
                            method="POST",
                            data-confirm-prompt-title=t("Unblock sender?"),
                            data-confirm-prompt-html=t("Please confirm if you wish to receive mail from <strong>%s</strong> at <strong>%s</strong> again.", _.escape(block.sender), _.escape(block.destination))
                          )
                            input(
                              type="hidden",
                              name="destination",
                              value=block.destination
                            )
                            input(
                              type="hidden",
                              name="sender",
                              value=block.sender
                            )
                            button.btn.btn-sm.btn-outline-secondary(
                              type="submit"
                            )= t("Unblock")
    if domain
      .row.text-center.my-5
        .col
          a.btn.btn-outline-secondary(
            href=l(`/my-account/domains/${punycode.toASCII(domain.name)}/aliases`)
          )
            i.fa.fa-angle-double-left
            = " "
            = t("Back to Mailboxes")
