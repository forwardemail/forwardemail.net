extends ../../../layout

block body
  include ../_modal-domain
  //- include ../_modal-openpgp-example
  .container.pt-3
    .row
      .col
        include ../../../_breadcrumbs
  .container.py-3
    .row
      .col
        .card.border-themed
          .card-body
            form.ajax-form(action=ctx.path, method="POST")
              include _form
              button.btn.btn-success.btn-block.btn-lg(type="submit")
                if alias
                  = t("Update Alias")
                else
                  = t("Create Alias")
    //- Recent sign-ins (see helpers/alias-sign-ins.js)
    if alias && Array.isArray(signIns) && alias.name !== "*" && !alias.name.startsWith("/")
      - const signInServices = { smtp: "SMTP", imap: "IMAP", pop3: "POP3", caldav: "CalDAV", carddav: "CardDAV", api: "API", managesieve: "ManageSieve" };
      .row.mt-3
        .col
          #recent-sign-ins.card.border-themed
            h2.card-header.h6.font-weight-bold= t("Recent Sign-Ins")
            .card-body
              p.small.text-muted
                = t("The IP addresses this alias was signed in from in the last 7 days, with the latest sign-in from each one.")
                = " "
                = t("If you do not recognize one, generate a new password for this alias.")
              if signIns.length === 0
                p.mb-0= t("This alias was not signed in to in the last 7 days.")
              else
                .table-responsive
                  table.table.table-sm.table-bordered.table-hover.mb-0
                    thead.thead-dark
                      tr
                        th(scope="col")= t("Service")
                        th(scope="col")= t("IP Address")
                        th(scope="col")= t("Latest Sign-In")
                    tbody
                      each signIn in signIns
                        tr
                          td.align-middle
                            span.badge.badge-dark.notranslate= signInServices[signIn.service] || signIn.service
                          td.align-middle.text-break
                            code= signIn.remote_address
                            if getIPLookupUrl(signIn.remote_address)
                              = " "
                              a.text-muted(
                                href=getIPLookupUrl(signIn.remote_address),
                                target="_blank",
                                rel="noopener noreferrer",
                                title=t("Look up on Cloudflare Radar")
                              ): i.fa.fa-globe
                          td.align-middle.text-nowrap
                            span.dayjs(data-time=signIn.date.getTime())= dayjs(signIn.date).tz(user.timezone === 'Etc/Unknown' ? 'UTC' : user.timezone).format("M/D/YY h:mm A z")
    if domain
      .row.text-center.my-5
        .col
          a.btn.btn-outline-secondary(
            href=l(`/my-account/domains/${punycode.toASCII(domain.name)}/aliases`)
          )
            i.fa.fa-angle-double-left
            = " "
            = t("Back to Aliases")
