include ../../_sort-header
include ../../_pagination
include ../_list-filters

- const timezone = user.timezone === "Etc/Unknown" ? "UTC" : user.timezone;
//- (the recipients shown in a row, the rest are on the page of the email)
- const MAX_RECIPIENTS = 5;
//- (the Date header is shown when it is later or earlier than this)
- const ONE_MINUTE = 60000;
//- (an address in the From header, e.g. "Jane <jane@example.com>")
- const getAddress = (value) => { const match = /<([^<>]+)>\s*$/.exec(value); return (match ? match[1] : value).trim(); };

//- From header (and MAIL FROM if it is another address)
mixin emailFrom(from, fromAddress, envelopeFrom)
  if from
    a.text-break(href=getFilterUrl({ q: fromAddress }))= from
  else
    span.text-muted= "—"
  if envelopeFrom && envelopeFrom.toLowerCase() !== fromAddress.toLowerCase()
    div
      span.badge.badge-pill.badge-dark= t("MAIL FROM")
      = " "
      a.text-break(href=getFilterUrl({ q: envelopeFrom })): code= envelopeFrom

//- RCPT TO (the rest are on the page of the email)
mixin emailRecipients(email, recipients)
  each rcpt in recipients.slice(0, MAX_RECIPIENTS)
    div
      a.text-break(href=getFilterUrl({ q: rcpt })): code= rcpt
  if recipients.length > MAX_RECIPIENTS
    div
      a(
        href=l(`/my-account/emails/${email.id}`),
        target="_blank",
        title=t("Recipients")
      )= `+${recipients.length - MAX_RECIPIENTS}`

.table-responsive
  table.table.table-hover.table-bordered.table-sm
    thead.thead-dark
      tr
        //- (Date, From and To are in the Email column on smaller screens)
        th.text-center.align-middle.d-none.d-md-table-cell(scope="col")
          +sortHeader("created_at", "Date", "#table-emails")
        th.text-center.align-middle.d-none.d-xl-table-cell(scope="col")
          +sortHeader("envelope.from", "From", "#table-emails")
        th.text-center.align-middle.d-none.d-xl-table-cell(scope="col")= t("To")
        th.text-center.align-middle(scope="col")
          +sortHeader("subject", "Email", "#table-emails")
        th.text-center.align-middle.d-none.d-md-table-cell(scope="col")
          +sortHeader("size", "Size", "#table-emails")
        th.text-center.align-middle.d-none.d-lg-table-cell(scope="col")
          +sortHeader("delivery_time", "Delivery Time", "#table-emails")
        th.text-center.align-middle(scope="col")
          +sortHeader("status", "Status", "#table-emails")
        th.text-center.align-middle(scope="col")= t("Actions")
    tbody
      if emails.length === 0
        tr
          td.alert.alert-info(colspan="8")
            if hasFilters
              = t("No emails exist for that search.")
            else
              = t("No emails have been stored yet.  Please check back later.")
      else
        each email in emails
          -
            const envelopeFrom = email.envelope && isSANB(email.envelope.from) ? email.envelope.from : "";
            const recipients = email.envelope && Array.isArray(email.envelope.to) ? email.envelope.to : [];
            const fromKey = email.headers && typeof email.headers === "object" ? Object.keys(email.headers).find((key) => key.toLowerCase() === "from") : undefined;
            const from = fromKey && isSANB(email.headers[fromKey]) ? email.headers[fromKey] : envelopeFrom;
            const fromAddress = getAddress(from);
            const deliveryMs = Number.isFinite(email.delivery_time) ? email.delivery_time : getEmailDeliveryTime(email);
            const accepted = Array.isArray(email.accepted) ? email.accepted : [];
            const rejectedErrors = Array.isArray(email.rejectedErrors) ? email.rejectedErrors : [];
          tr
            //- when it was sent to us
            td.align-middle.text-nowrap.d-none.d-md-table-cell
              small.text-monospace
                span.dayjs(data-time=email.created_at.getTime())= dayjs(email.created_at).tz(timezone).format("M/D/YY h:mm A z")
            td.align-middle.small.d-none.d-xl-table-cell
              +emailFrom(from, fromAddress, envelopeFrom)
            td.align-middle.small.d-none.d-xl-table-cell
              +emailRecipients(email, recipients)
            //- Subject, Message-ID, ID and the client that sent it
            td.align-middle
              a.font-weight-bold.text-themed.text-break(
                href=l(`/my-account/emails/${email.id}`),
                target="_blank"
              )= isSANB(email.subject) ? email.subject : "—"
              ul.list-unstyled.small.mb-0
                //- (Date, From and To on smaller screens, as their columns are not shown)
                li.d-md-none.text-monospace
                  span.dayjs(data-time=email.created_at.getTime())= dayjs(email.created_at).tz(timezone).format("M/D/YY h:mm A z")
                li.d-xl-none
                  span.badge.badge-pill.badge-primary= "FROM"
                  = " "
                  +emailFrom(from, fromAddress, envelopeFrom)
                if recipients.length > 0
                  li.d-xl-none
                    span.badge.badge-pill.badge-primary= "TO"
                    +emailRecipients(email, recipients)
                li
                  span.badge.badge-pill.badge-primary= "MESSAGE-ID"
                  = " "
                  code.text-break= email.messageId
                //- Date header, if it is not when it was sent to us
                //- (e.g. it was scheduled to be sent later)
                if email.date && Math.abs(email.date.getTime() - email.created_at.getTime()) >= ONE_MINUTE
                  li
                    span.badge.badge-pill.badge-primary= "DATE"
                    = " "
                    span.text-monospace
                      span.dayjs(data-time=email.date.getTime())= dayjs(email.date).tz(timezone).format("M/D/YY h:mm A z")
                li
                  span.badge.badge-pill.badge-dark= "ID"
                  = " "
                  code.text-break= email.id
                //- IP address of the client that sent it (SMTP or API)
                if email.remote_address
                  li
                    span.badge.badge-pill.badge-dark= "CLIENT IP"
                    = " "
                    a.text-break(
                      href=getFilterUrl({ q: email.remote_address })
                    ): code= email.remote_address
                    if getIPLookupUrl(email.remote_address)
                      = " "
                      a.text-muted(
                        href=getIPLookupUrl(email.remote_address),
                        target="_blank",
                        rel="noopener noreferrer",
                        title=t("Look up on Cloudflare Radar")
                      ): i.fa.fa-globe
                //- (the size and delivery time on small screens)
                if Number.isFinite(email.size)
                  li.d-md-none
                    span.badge.badge-pill.badge-secondary
                      i.fa.fa-file.mr-1
                      = bytes(email.size)
                if Number.isFinite(deliveryMs) && deliveryMs > 0
                  li.d-lg-none
                    i.fa.fa-clock.mr-1
                    +deliveryTime(deliveryMs)
            //- Size of the message when it was sent
            td.align-middle.text-center.text-nowrap.d-none.d-md-table-cell
              if Number.isFinite(email.size)
                small.text-monospace= bytes(email.size)
              else
                small.text-muted= "—"
            //- from when it was sent (or scheduled for) to its last delivery
            td.align-middle.text-center.text-nowrap.d-none.d-lg-table-cell
              +deliveryTime(deliveryMs)
            //- Status and the response for each recipient
            td.align-middle.small
              //- pending (secondary)
              //- queued (dark)
              //- sent (success)
              //- partially_sent (primary)
              //- deferred (warning)
              //- bounced (danger)
              //- rejected (danger)
              - let className = "badge-secondary";
              case email.status
                when 'pending'
                  - className = "badge-secondary";
                when 'queued'
                  - className = "badge-dark";
                when 'sent'
                  - className = "badge-success";
                when 'partially_sent'
                  - className = "badge-primary";
                when 'deferred'
                  - className = "badge-warning";
                when 'bounced'
                  - className = "badge-danger";
                when 'rejected'
                  - className = "badge-danger";
              a.badge.text-uppercase(
                class=className,
                href=getFilterUrl({ status: email.status })
              )= titleize(humanize(email.status))
              if accepted.length > 0 || rejectedErrors.length > 0
                ul.list-unstyled.mb-0.mt-1
                  each address in accepted
                    li
                      +responseCodeBadge(250, getFilterUrl({ response_codes: 250, response_code: undefined }))
                      if recipients.length > 1
                        = " "
                        code= address
                  each rejectedError in rejectedErrors
                    li
                      if Number.isInteger(rejectedError.responseCode)
                        //- (a link if the list can be filtered by it)
                        +responseCodeBadge(rejectedError.responseCode, isResponseCode(rejectedError.responseCode) ? getFilterUrl({ response_codes: rejectedError.responseCode, response_code: undefined }) : undefined)
                        = " "
                      if recipients.length > 1 && rejectedError.recipient
                        strong= rejectedError.recipient
                        = " "
                      span.text-monospace.text-break!= rejectedError.response ? safeAnsiHTML(rejectedError.response) : safeAnsiHTML(rejectedError.message)
            td.align-middle.text-center
              ul.list-inline.mb-0
                li.list-inline-item
                  a.btn.btn-dark.btn-sm(
                    href=l(`/my-account/emails/${email.id}`),
                    target="_blank",
                    data-toggle="tooltip",
                    data-placement="bottom",
                    title=t("View Details")
                  ): i.fa.fa-fw.fa-search
                li.list-inline-item
                  a.btn.btn-primary.btn-sm(
                    href=l(`/my-account/emails/${email.id}.eml`),
                    data-toggle="tooltip",
                    data-placement="bottom",
                    title=t("Download")
                  ): i.fa.fa-fw.fa-file-download
                //- Resend (see app/controllers/web/my-account/resend-email.js)
                if isResendable(email)
                  li.list-inline-item
                    form.ajax-form.confirm-prompt(
                      action=l(`/my-account/emails/${email.id}/resend`),
                      method="POST",
                      autocomplete=config.env === "test" ? "off" : randomstring(),
                      data-confirm-prompt-html=t("A copy of this email will be queued and sent again to all of its recipients.")
                    )
                      button.btn.btn-success.btn-sm(
                        type="submit",
                        data-toggle="tooltip",
                        data-title=t("Resend email"),
                        data-placement="bottom"
                      ): i.fa.fa-fw.fa-redo
                else if email.is_redacted && isResendable(email, true)
                  //- (a disabled button shows no tooltip, so it is on a wrapper)
                  li.list-inline-item
                    span.d-inline-block(
                      tabindex="0",
                      data-toggle="tooltip",
                      data-placement="bottom",
                      title=t("This email cannot be resent because its content was redacted after it was sent.  To keep the content of sent emails so they can be resent, set a retention period in the Advanced Settings of your domain.")
                    )
                      button.btn.btn-secondary.btn-sm(
                        type="button",
                        disabled,
                        style="pointer-events: none"
                      ): i.fa.fa-fw.fa-redo
                //- Only allow remove if
                //- - pending
                //- - queued
                //- - deferred
                if ['pending','queued','deferred'].includes(email.status)
                  li.list-inline-item
                    form.ajax-form.confirm-prompt(
                      action=l(`/my-account/emails/${email.id}`),
                      method="POST",
                      autocomplete=config.env === "test" ? "off" : randomstring()
                    )
                      input(type="hidden", name="_method", value="DELETE")
                      button.btn.btn-danger.btn-sm(
                        type="submit",
                        data-toggle="tooltip",
                        data-title=t("Remove"),
                        data-placement="bottom"
                      ): i.fa.fa-fw.fa-remove

+paginate('#table-emails')
