//- Byline: author, published date and time to read. One look everywhere it
//- appears (articles, guides, docs, the index page headers), with no artwork.
//-
//- Included directly by pages, and by the feByline mixin in
//- _fe-page-header.pug for the dark page headers. Set `bylineOnDark = true`
//- before including it inside a dark fe surface; otherwise it carries
//- .fe-surface-light for its colours, which re-points to the dark ramp in
//- dark mode (the page around it may be outside any fe scope).
- const published = getPublishedDate(publishedISOString, user);
- const bylineSurface = typeof bylineOnDark !== "undefined" && bylineOnDark ? "" : "fe-surface-light";
ul.fe-byline.no-search(class=bylineSurface)
  li
    span.fe-byline__label.fe-label= t("Written by")
    span.fe-byline__value
      i.fa.fa-check-circle(aria-hidden="true")
      = config.appName
      = " "
      = t("Team")
  li
    span.fe-byline__label.fe-label= t("Published")
    span.fe-byline__value.dayjs(
      data-time=published.time,
      data-time-style="false"
    )= published.formatted
  li
    span.fe-byline__label.fe-label= t("Time to read")
    span.fe-byline__value= t("Less than 5 minutes")
  //- Opens the share dialog that _footer.pug renders on public pages
  //- (hidden without JavaScript, which the dialog needs)
  if typeof isNotPrivateRoute !== "undefined" && isNotPrivateRoute
    li.no-js
      span.fe-byline__label.fe-label= t("Share")
      button.fe-byline__value.fe-byline__share(
        type="button",
        data-toggle="modal",
        data-target="#modal-share",
        data-share-open
      )
        i.fas.fa-share-alt(aria-hidden="true")
        = t("Share this page")
