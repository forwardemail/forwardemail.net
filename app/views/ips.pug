                a.badge.badge-primary(
                  target="_blank",
                  href=`${config.urls.web}/ips/v4.txt`
                )
                  span.text-monospace= "TXT"
                  = " "
                  i.fa.fa-external-link
              //- txt file download without comments
              li.list-inline-item
                a.badge.badge-primary(
                  target="_blank",
                  href=`${config.urls.web}/ips/v4.txt?comments=false`
                )
                  span.text-monospace= "TXT"
                  = " "
                  = t("without comments")
                  = " "
                  i.fa.fa-external-link
              //- json file donwload
              li.list-inline-item
                a.badge.badge-primary(
                  target="_blank",
