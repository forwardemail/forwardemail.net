extends layout

include _fe-page-header

block body
  //- The header is the shared fe page header; the four address cards below
  //- it are unchanged. They are bootstrap cards with highlighted code, and
  //- they sit outside the .fe-landing wrapper on purpose: app-dark.scss
  //- restyles .card and .markdown-body with !important, so inside an fe
  //- scope they would fight the tokens (see the note atop _fe-tokens.scss).
  .fe-landing(class=isFeFlushNav ? "fe-landing--flush" : "")
    +fePageHeader({ id: "fe-ips", icon: "fa fa-server", eyebrow: t("We publish our server's IP addresses below."), title: t("IP Addresses"), body: t("This page is published mainly for email service providers and system administrators as the definitive source of our server infrastructure's addresses.") })
      .fe-actions.fe-page-header__actions
        a.fe-btn.fe-btn--subtle.fe-btn--md(
          href=`${config.urls.web}/ips.txt`,
          target="_blank"
        )
          i.fa.fa-file-alt(aria-hidden="true")
          = "ips.txt"
        a.fe-btn.fe-btn--subtle.fe-btn--md(
          href=`${config.urls.web}/ips.json`,
          target="_blank"
        )
          i.fa.fa-code(aria-hidden="true")
          = "ips.json"
  .container.py-3.py-md-4.py-lg-5
    .row
      .col-12
        //- hostnames
        .card.rounded-lg.border-themed.mb-3
          h2.h6.card-header= t("Hostnames")
          .card-body
            .markdown-body
              pre
                code.hljs.language-sh
                  != hljs.highlight(hostnames, { language: "sh", ignoreIllegals: true }).value
          .card-footer.text-right
            ul.list-inline.mb-0
              li.list-inline-item.font-weight-bold.small= t("Also available as")
              //- txt file download
              li.list-inline-item
                a.badge.badge-primary(
                  target="_blank",
                  href=`${config.urls.web}/ips/hostnames.txt`
                )
                  span.text-monospace= "TXT"
                  = " "
                  i.fa.fa-external-link
              //- json file donwload
              li.list-inline-item
                a.badge.badge-primary(
                  target="_blank",
                  href=`${config.urls.web}/ips/hostnames.json`
                )
                  = "JSON"
                  = " "
                  i.fa.fa-external-link
        //- ipv4 and ipv6
        .card.rounded-lg.border-themed.mb-3
          h2.h6.card-header= t("IPv4 and IPv6 addresses")
          .card-body
            .markdown-body
              pre
                code.hljs.language-sh
                  != hljs.highlight(ips, { language: "sh", ignoreIllegals: true }).value
          .card-footer.text-right
            ul.list-inline.mb-0
              li.list-inline-item.font-weight-bold.small= t("Also available as")
              //- txt file download
              li.list-inline-item
                a.badge.badge-primary(
                  target="_blank",
                  href=`${config.urls.web}/ips.txt`
                )
                  span.text-monospace= "TXT"
                  = " "
                  i.fa.fa-external-link
              //- txt file download without comments
              li.list-inline-item
                a.badge.badge-primary(
                  target="_blank",
                  href=`${config.urls.web}/ips.txt?comments=false`
                )
                  span.text-monospace= "TXT"
                  = " "
                  = t("without comments")
                  = " "
                  i.fa.fa-external-link
              //- json file donwload
              li.list-inline-item
                a.badge.badge-primary(
                  target="_blank",
                  href=`${config.urls.web}/ips.json`
                )
                  = "JSON"
                  = " "
                  i.fa.fa-external-link
        //- ipv4
        .card.rounded-lg.border-themed.mb-3
          h2.h6.card-header= t("IPv4 addresses only")
          .card-body
            .markdown-body
              pre
                code.hljs.language-sh
                  != hljs.highlight(ipv4, { language: "sh", ignoreIllegals: true }).value
