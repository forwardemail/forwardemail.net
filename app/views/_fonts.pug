//- Font preloads.
//-
//- - Nunito Sans 400/700 is the body and fe display face. The hero h1 (the
//-   mobile LCP element) is Nunito Sans 700, so both load at high priority.
//- - Font Awesome is not preloaded: the build cuts it down to the icons the
//-   site uses (about 17 KB for solid + brands, from 155 KB) under a
//-   content-hashed name that only the stylesheet knows (see faSubset in
//-   gulpfile.js), so there is nothing left for it to compete with.
//-
//- https://caniuse.com/link-rel-preload
//- integrity attribute not currently supported <https://crbug.com/981419>
- const fonts = [];
- fonts.push({ file: "nunito-sans-latin-700.woff2", priority: "high" });
- fonts.push({ file: "nunito-sans-latin-400.woff2", priority: "high" });
each font in fonts
  link(
    rel="preload",
    href=manifest(`fonts/${font.file}`),
    type="font/woff2",
    as="font",
    crossorigin="anonymous",
    fetchpriority=font.priority
  )
