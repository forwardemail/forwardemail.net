    },
    {
      id: 'sync',
      tab: 'Sync',
      kicker: 'Sync',
      tone: 'vault',
      title: 'Calendars, contacts & tasks',
      promise: 'Calendars, contacts and tasks use the open CalDAV and CardDAV standards. Sign in with the same address and password as your mailbox.',
      cards: [
        { label: 'CalDAV', sub: 'Send and answer meeting invitations.' },
