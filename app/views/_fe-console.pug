//- The hero console. Six views of the platform behind one tab rail, so the
//- hero carries the whole product rather than the one slice a static diagram
//- could show. Replaces the single delivery-path graphic that used to live in
//- _fe-hero.pug.
//-
//- Every panel ships in the DOM on every request. Without JavaScript they are
//- all visible, stacked, and the rail (whose buttons would have nothing to
//- do) is hidden, so the page still says everything it has to say and every
//- word stays crawlable. The collapse to one-at-a-time is done in CSS off
//- `html.no-js`, which _meta.pug strips in the head, so there is no flash of
//- six panels and no layout shift.

//- Content lives here rather than inside the mixins so the six views read as
//- one table and the story arc (route, store, send, sync, observe, use) can be
//- checked by reading straight down.
//-
//- `tone` picks the kicker and dot colour. Every value is text-legal on the
//- dark hero surface: `primary` resolves to --fe-primary-lift rather than
//- --fe-primary, which is 3.1:1 on Ink and would fail as a text colour.
//-
//- Prices are pulled from config.views.locals.planPricing through `subArg`
//- rather than written into the copy, for the same reason _pricing-table.pug
//- stopped writing them: a figure inside a translation string can be rewritten
//- by the translation job.
-
  var feConsoleViews = [
    {
      id: 'forward',
      tab: 'Forward',
      kicker: 'Route',
      tone: 'primary',
      title: 'Forwarding & aliases',
      promise: 'Add our MX records, and every address on your domain is yours. We have forwarded email since %d, and %s domains use us today.',
      // the year we started, and the domain count as the hero gives it, in
      // the page's own number format ("1.6M+", "1,6 Mio.+", "160万+")
      promiseArgs: [2017, `${new Intl.NumberFormat(locale, { notation: 'compact', maximumFractionDigits: 1, numberingSystem: 'latn' }).format(1600000)}+`],
      cards: [
        { label: 'Unlimited aliases', sub: 'We never charge per alias or per user.' },
        { label: 'Catch-all & regex', sub: 'Send every address, or any regex match, to the inbox you choose.' },
        { label: 'Multi-recipient', sub: 'One alias can reach people, teams and webhooks.' },
        { label: 'Disposable', sub: 'Turn off an alias without deleting its mail.' }
      ],
      glyph: '→',
      evidence: 'forward hello@studio.dev → you@gmail.com · 41ms'
    },
    {
      id: 'mailbox',
      tab: 'Mailbox',
      kicker: 'Store',
      tone: 'mint',
      title: 'Encrypted mailboxes',
      // (as the technical whitepaper, /technical-whitepaper.pdf, describes them)
      promise: 'According to our technical whitepaper, each mailbox is its own SQLite file, encrypted at rest with ChaCha20-Poly1305. The key is your mailbox password, and only you have it.',
      cards: [
        { label: 'IMAP · POP3', sub: 'Works in Apple Mail, Thunderbird and phone apps.' },
        { label: '10 GB pooled', sub: 'One storage pool for all your domains.' },
        { label: 'Zero-knowledge', sub: 'Quantum-resistant encryption on every mailbox.' },
        { label: 'Search & filters', sub: 'Search on the server, without downloading every message.' }
      ],
      glyph: '✓',
      evidence: 'imap.forwardemail.net · TLS 1.3 ·',
      note: 'mailbox sealed'
    },
    {
      id: 'send',
      tab: 'Send',
      kicker: 'Send',
      tone: 'signal',
      title: 'Outbound SMTP & newsletters',
      promise: 'Send as your domain from an app, a script or a campaign. We sign each message with your domain\'s DKIM key, so receivers can check it came from you.',
      cards: [
        { label: 'Unlimited outbound (reputation-based)', sub: 'Included on every paid plan from $%d/mo.', subArg: planPricing.enhanced },
        { label: 'SMTP relay', sub: 'Works with any app or framework that speaks SMTP.' },
        { label: 'Newsletters', sub: 'Each domain needs a one-time review, usually within 24 hours.' },
        { label: 'Pre-warmed IPs', sub: 'We publish the IP addresses we send from.' }
      ],
