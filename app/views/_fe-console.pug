//- Visitors without JavaScript (including crawlers that do not run it) get
//- every view visible and stacked through html.no-js (see _fe-home.scss).
mixin feConsole
  .fe-console(data-fe-console)
    //- The rail is a row of buttons that name their view through `data-target`,
    //- the same hook the modal and collapse triggers on the page use, rather
    //- than `href="#view"` links: a link would put `#mailbox` into the address
    //- bar on every click (and core.js scrolls the page for every `a[href^="#"]`
    //- it sees). assets/js/hero-console.js labels the rail as a tablist and
    //- takes over the arrow keys once it has loaded: announcing tab semantics
    //- before anything can answer an arrow key would promise a screen reader an
    //- interaction that does not exist yet. /#send stays deep-linkable from docs
    //- and support because every view still carries its id and the script
    //- opens on the view the hash names.
    .fe-console__rail-wrap(data-fe-console-rail-wrap)
      button.fe-console__rail-control.fe-console__rail-control--previous.no-js(
        type="button",
        disabled,
        data-fe-console-scroll="previous",
        aria-label=t("Show previous platform area")
      )
        i.fa.fa-chevron-left(aria-hidden="true")
      .fe-console__rail(aria-label=t("Platform"), data-fe-console-rail)
        each view, i in feConsoleViews
          //- The pill is rendered here rather than left to JavaScript so the
          //- first view is not shown under a rail with nothing selected for the
          //- window between paint and DOMContentLoaded. aria-selected is not set
          //- here on purpose: until hero-console.js runs these are buttons, not
          //- tabs, and the attribute would be meaningless on them.
          button.fe-console__tab(
            id=`tab-${view.id}`,
            type="button",
            class=i === 0 ? "fe-console__tab--active" : "",
            data-target=`#${view.id}`,
            data-fe-console-tab
          )= t(view.tab)
          = " "
      button.fe-console__rail-control.fe-console__rail-control--next.no-js(
        type="button",
        disabled,
        data-fe-console-scroll="next",
        aria-label=t("Show next platform area")
      )
        i.fa.fa-chevron-right(aria-hidden="true")
      p.fe-console__rail-hint.no-js(data-fe-console-rail-hint)
        i.fa.fa-arrows-h(aria-hidden="true")
        = " "
        = t("Swipe or scroll to see all platform areas.")

    .fe-console__views
      each view, i in feConsoleViews
        +feConsoleView(view, i === 0)

//- One view. Kicker and dot teach the pipeline stage, the title and promise say
//- what it is, the four cards carry the specifics the old feature list used to,
//- and the evidence line is real output rather than another sentence of pitch.
mixin feConsoleView(view, isFirst)
  //- Named by its own heading rather than by its tab, in both modes. As a
  //- section that is the only correct name, and as a tabpanel the heading says
  //- more than the one word on the tab does.
  section.fe-console__view(
    id=view.id,
    class=[`fe-console__view--${view.tone}`, isFirst ? "fe-console__view--active" : ""],
    aria-labelledby=`view-${view.id}-title`,
    data-fe-console-view=view.id
  )
    p.fe-console__kicker
      span.fe-console__dot(aria-hidden="true")
      = t(view.kicker)

    h2.fe-console__heading(id=`view-${view.id}-title`)= t(view.title)
    p.fe-text.fe-console__promise= view.promiseArgs ? t(view.promise, ...view.promiseArgs) : t(view.promise)

    ul.fe-grid.fe-grid--2.fe-console__cards
      each card in view.cards
        +feConsoleCard(card)

    p.fe-console__evidence.fe-code
      if view.glyph
        span.fe-console__evidence-glyph(aria-hidden="true")= view.glyph
        = " "
      span= view.evidence
      if view.note
        = " "
        span= t(view.note)

mixin feConsoleCard(card)
  li.fe-console__card
    //- (the spaces keep the words apart in the page's text, e.g. for
    //- search engines and screen readers; the flex layout drops them)
    span.fe-console__card-label= t(card.label)
    = " "
    span.fe-console__card-sub= card.subArg === undefined ? t(card.sub) : t(card.sub, card.subArg)
