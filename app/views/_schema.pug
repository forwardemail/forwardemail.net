//- Comprehensive JSON-LD Schema Markup for SEO
//- This file generates structured data for all page types
//- (the organization is described in full once, in _wikipedia.pug; every
//-  other node names it with the same @id, so they read as one entity)

//- Our Trustpilot rating (helpers/aggregate-rating.js asks for it once a
//- month), on the pages that also show it (_fe-rating.pug under the
//- testimonials): structured data may only carry a rating the page shows
-
  var schemaRating = typeof aggregateRating !== "undefined" && aggregateRating ? { "@type": "AggregateRating", "ratingValue": String(aggregateRating.ratingValue), "ratingCount": String(aggregateRating.ratingCount), "bestRating": "5", "worstRating": "1" } : undefined;

//- SoftwareApplication Schema (for homepage and main pages)
if ctx.pathWithoutLocale === '/'
  -
    var softwareApplicationSchema = {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Forward Email",
      "applicationCategory": "CommunicationApplication",
      "operatingSystem": "Web, iOS, Android, Windows, macOS, Linux",
      "offers": { "@type": "Offer", "price": String(planPricing.free), "priceCurrency": "USD" },
      "aggregateRating": schemaRating,
      "description": "Free email forwarding for custom domains. Send and receive email as you@yourdomain.com with unlimited aliases, IMAP, POP3, SMTP, and 100% open-source security.",
      "url": "https://forwardemail.net",
      "downloadUrl": `https://forwardemail.net/${locale}/download`,
      // (the apps on every device, the poster of the apps video)
      "screenshot": "https://forwardemail.net/img/video/forward-email-apps.jpg",
      "softwareVersion": pkgVersion,
      "releaseNotes": "https://forwardemail.net/en/event-feed",
      "author": { "@type": "Organization", "@id": "https://forwardemail.net/#organization", "name": "Forward Email", "legalName": "Forward Email LLC", "url": "https://forwardemail.net" },
      "featureList": ["Free email forwarding", "Custom domain support", "Unlimited aliases", "IMAP and POP3 access", "SMTP sending", "End-to-end encryption", "Open source", "10GB storage", "Webhook support", "RESTful API"]
    };
  script(type="application/ld+json", nonce=nonce)!= JSON.stringify(softwareApplicationSchema).replace(/</g, "\\u003c")

//- Speakable Schema (homepage)
if ctx.pathWithoutLocale === '/'
  script(type="application/ld+json", nonce=nonce).
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Forward Email - Free Email Forwarding for Custom Domains",
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", ".lead", ".h3"]
      },
      "url": "https://forwardemail.net",
      "isPartOf": { "@id": "https://forwardemail.net/#website" },
      "author": { "@type": "Organization", "@id": "https://forwardemail.net/#organization", "name": "Forward Email", "legalName": "Forward Email LLC", "url": "https://forwardemail.net" },
      "publisher": { "@type": "Organization", "@id": "https://forwardemail.net/#organization", "name": "Forward Email", "legalName": "Forward Email LLC", "url": "https://forwardemail.net" }
    }

//- (every node that names the company is the Organization node of
//- _wikipedia.pug: its @id, name, legalName and url)

//- WebAPI Schema for API page
if ctx.pathWithoutLocale === '/email-api'
  script(type="application/ld+json", nonce=nonce).
    {
      "@context": "https://schema.org",
      "@type": "WebAPI",
      "name": "Forward Email API",
      "description": "RESTful API for sending and managing email, domains, aliases, and more.",
      "documentation": "https://forwardemail.net/#{locale}/email-api",
      "provider": { "@type": "Organization", "@id": "https://forwardemail.net/#organization", "name": "Forward Email", "legalName": "Forward Email LLC", "url": "https://forwardemail.net" }
    }

//- WebSite Schema with SearchAction
if ctx.pathWithoutLocale === '/'
  script(type="application/ld+json", nonce=nonce).
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://forwardemail.net/#website",
      "name": "Forward Email",
      "url": "https://forwardemail.net",
      "publisher": { "@type": "Organization", "@id": "https://forwardemail.net/#organization", "name": "Forward Email", "legalName": "Forward Email LLC", "url": "https://forwardemail.net" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://forwardemail.net/en/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }

//- BreadcrumbList Schema for non-homepage pages
//- (Home, then each parent path that is a page of its own, then this page,
//-  named by the first part of their titles as plain text: the titles hold
//-  markup such as <span class="notranslate">, which was published as is)
if ctx.pathWithoutLocale && ctx.pathWithoutLocale !== '/'
  -
    var schemaCrumbName = function (title) {
      return striptags(convert(title || "")).split(" - ")[0].trim();
    };
    var schemaCrumbs = [{ name: t("Home"), item: `${config.urls.web}/${locale}` }];
    var schemaSegments = ctx.pathWithoutLocale.split("/").filter(Boolean);
    schemaSegments.slice(0, -1).forEach(function (segment, index) {
      var schemaParent = `/${schemaSegments.slice(0, index + 1).join("/")}`;
      if (config.meta[schemaParent])
        schemaCrumbs.push({
          name: schemaCrumbName(t(config.meta[schemaParent][0])),
          item: `${config.urls.web}/${locale}${schemaParent}`
        });
    });
    schemaCrumbs.push({
      name: schemaCrumbName(meta && meta.title) || schemaSegments[schemaSegments.length - 1],
      item: `${config.urls.web}/${locale}${ctx.pathWithoutLocale}`
    });
    var breadcrumbSchema = {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": schemaCrumbs.map(function (crumb, index) {
        return { "@type": "ListItem", "position": index + 1, "name": crumb.name, "item": crumb.item };
      })
    };
  script(type="application/ld+json", nonce=nonce)!= JSON.stringify(breadcrumbSchema).replace(/</g, "\\u003c")

//- FAQPage Schema for FAQ page (generated from the FAQ markdown of the page's
//- locale, with Redis caching; none when that is unavailable, since the
//- questions must be the ones the page shows)
if ctx.pathWithoutLocale === '/faq' && faqSchemaData && faqSchemaData.mainEntity && faqSchemaData.mainEntity.length
  script(type="application/ld+json", nonce=nonce)!= JSON.stringify(faqSchemaData).replace(/</g, "\\u003c")

//- Product Schema for pricing/comparison pages
if ctx.pathWithoutLocale && ctx.pathWithoutLocale.includes('alternative')
  -
    var productSchema = {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Forward Email",
      "description": "Privacy-focused email forwarding and hosting service with unlimited aliases, custom domain support, and 100% open-source code.",
      "image": "https://forwardemail.net/img/social.png",
      "brand": { "@type": "Brand", "name": "Forward Email" },
      "offers": { "@type": "AggregateOffer", "lowPrice": String(planPricing.free), "highPrice": String(planPricing.team), "priceCurrency": "USD", "offerCount": "3" },
      "aggregateRating": schemaRating
    };
  script(type="application/ld+json", nonce=nonce)!= JSON.stringify(productSchema).replace(/</g, "\\u003c")

//- BlogPosting Schema for blog posts and guides (improves rich results and AI/GEO citations)
//- Excludes feed endpoints and the /blog and /blog/open-source index landing pages
if ctx.pathWithoutLocale && (ctx.pathWithoutLocale.startsWith('/blog/') || ctx.pathWithoutLocale.startsWith('/guides/')) && !ctx.pathWithoutLocale.startsWith('/blog/feed') && ctx.pathWithoutLocale !== '/blog/open-source'
  -
    var blogPublishedISOString = config.env === "test" ? "2023-01-01T00:00:00.000Z" : (typeof publishedISOString !== "undefined" && publishedISOString ? publishedISOString : dayjs().startOf("month").toDate().toISOString());
    var blogModifiedISOString = config.env === "test" ? "2023-01-01T00:00:00.000Z" : (typeof publishedISOString !== "undefined" && publishedISOString ? publishedISOString : dayjs().startOf("day").toDate().toISOString());
    var blogPostingSchema = {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `${config.urls.web}${ctx.path}`
      },
      "headline": striptags(convert(meta.title)),
      "description": striptags(convert(meta.description)),
      "image": ogImage,
      "url": `${config.urls.web}${ctx.path}`,
      "datePublished": blogPublishedISOString,
      "dateModified": blogModifiedISOString,
      "inLanguage": locale,
      "author": { "@type": "Organization", "@id": "https://forwardemail.net/#organization", "name": "Forward Email", "legalName": "Forward Email LLC", "url": "https://forwardemail.net" },
      "publisher": {
        "@type": "Organization",
        "@id": "https://forwardemail.net/#organization",
        "name": "Forward Email",
        "legalName": "Forward Email LLC",
        "url": "https://forwardemail.net",
        "logo": {
          "@type": "ImageObject",
          "url": `${config.urls.web}/img/logo-square-180x180.png`
        }
      }
    };
  script(type="application/ld+json", nonce=nonce)!= JSON.stringify(blogPostingSchema)
