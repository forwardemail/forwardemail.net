//- Redesigned pricing grid, per section 4 of the landing page build spec.
//- Continues the light surface from the product section with no visible break.
//-
//- The plans come from _fe-plan-data.pug, which the detail cards on the
//- pricing template read too, so names, prices and destinations cannot
//- drift between the two grids.
mixin fePricing
  include _fe-plan-data

  section.fe-section.fe-surface-light.fe-section--pad.fe-section--tight.fe-pricing(
    aria-labelledby="fe-pricing-title"
  )
    .fe-container
      p.fe-eyebrow.fe-eyebrow--mint.fe-label
        i.fa.fa-tag(aria-hidden="true")
        = t("Simple pricing")

      .fe-pricing__head
        h2#fe-pricing-title.fe-display-lg= t("Unlimited domains at every tier.")
        a.fe-pricing__aside(href=l("/private-business-email"))= t("Recommended for most professionals")

      //- Section 7 replacement copy.
      p.fe-lede= t("Start with forwarding, upgrade to real mailboxes, then add team controls. Every tier includes unlimited domains.")

      //- A ul of li, with the feature lists nested. DOM order follows price
      //- order; the mobile reordering that puts Enhanced first is done with
      //- CSS order so the reading order never changes.
      ul.fe-grid.fe-grid--md-2.fe-grid--lg-4.fe-grid--gap-5
        each plan in Object.values(fePlans)
          li(class=plan.featured ? "fe-grid__item--first" : "")
            div(
              class=plan.featured ? "fe-panel fe-panel--featured fe-surface-dark fe-plan fe-plan--compact" : "fe-panel fe-plan fe-plan--compact"
            )
              h3.fe-display-sm.fe-plan__name= plan.summary.name || plan.name
              p.fe-plan__line= plan.summary.line
              span.fe-plan__price.fe-numeral $#{ plan.price }
              span.fe-plan__period= t("/ month · unlimited domains")
              a.fe-plan__cta.fe-btn.fe-btn--md.fe-btn--block(
                href=plan.href,
                class=plan.featured ? "fe-btn--hero" : "fe-btn--subtle"
              )= plan.summary.cta
              ul.fe-plan__features
                each feature in plan.summary.features
                  li.fe-plan__feature
                    i.fa.fa-check.fe-plan__icon(aria-hidden="true")
                    span= feature
