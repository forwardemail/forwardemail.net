extends layout

block append scripts
  +script("js/download.js")

block body
  //- Inlined by pug, so archLabels, formatLabels, formatNotes and
  //- platformMeta are in scope for both partials below.
  include _fe-download-labels
  include _fe-download-hero
  include _fe-download-platforms
  include _fe-download-verify

  //- fe-landing carries the page's typography and token scoping. The flush
  //- modifier pulls the first section up under the fixed navbar; the hero's
  //- own top padding already clears the bar, so this is right whether the bar
  //- is transparent (logged out) or opaque (signed in). Without it a signed
  //- in visitor saw a strip of body background between bar and hero.
  .fe-landing(class=isFeHeroUnderBar ? "fe-landing--flush" : "")
    +feDownloadHero
    +feDownloadPlatforms
    +feDownloadVerify
