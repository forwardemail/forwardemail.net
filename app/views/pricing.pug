extends layout

block append scripts
  if !isBot(ctx.get('User-Agent'))
    if config.env === 'test'
      script(
        nonce=nonce,
        defer,
        src=`${config.urls.web}/js/domain-search.js`,
        crossorigin="anonymous"
      )
    else
      script(
        nonce=nonce,
        defer,
        src=manifest("js/domain-search.js"),
        integrity=manifest("js/domain-search.js", "integrity"),
        crossorigin="anonymous"
      )

block body
  include _modal-domain-search
  +modalDomainSearch
  include _modal-storage
  if !user || isBot(ctx.get('User-Agent'))
    #modal-watch-video.modal.fade(
      tabindex="-1",
      role="dialog",
      aria-labelledby="modal-pricing-video-title",
      aria-hidden="true"
    )
      .modal-dialog.modal-lg(role="document")
        .modal-content
          .modal-header.text-center.d-block
            #modal-watch-video-title.h4.d-inline-block.ml-4= t("Product Tour")
            button.close(
              type="button",
              data-dismiss="modal",
              aria-label="Close"
            )
              span(aria-hidden="true") &times;
          .modal-body
            .lazyframe(
              title=t("Forward Email's Paid Plans"),
              data-vendor="youtube_nocookie",
              data-src="https://www.youtube-nocookie.com/embed/N6zjv40zuIY?autoplay=0"
            )

  //-.
    if !isBot(ctx.get('User-Agent'))
      .fixed-bottom.text-center.d-print-none.d-lg-none
        .bg-dark.p-2.border-top.border-themed
          ul.list-inline.mb-0
            li.list-inline-item
              a.btn.btn-sm.btn-light(href="#free")
                = t("Free")
                = " "
                i.fa.fa-search-plus
            li.list-inline-item
              a.btn.btn-sm.btn-success(href="#enhanced")
                = t("Enhanced")
                = " "
                i.fa.fa-search-plus
            li.list-inline-item
              a.btn.btn-sm.btn-primary(href="#team")
                = t("Team")
                = " "
                i.fa.fa-search-plus

  //- Bots are included deliberately: the h1 carries the per-route useCases
  //- headline, which is the SEO content of all 7,252 programmatic pages.
  //- ?pricing=true no longer drops the hero: the redesigned hero is compact,
  //- so the "jump to pricing" nav link still lands the table in view while
  //- the page opens on the new surface (matches isFePricingPage in
  //- _fe-flags.pug).
  if !user || isBot(ctx.get('User-Agent'))
    include _fe-pricing-hero
    //- .fe-landing is wrapped around the hero alone rather than the whole page,
    //- because everything below it is still the previous design. The flush
    //- modifier pulls it under the fixed navbar, which is transparent on these
    //- routes.
    .fe-landing.fe-landing--flush
      +fePricingHero
    //-.
      if !isBot(ctx.get('User-Agent'))
        a.text-decoration-none.pt-1.pb-4.pt-lg-4.text-uppercase.text-white.mx-auto.bounce-animation(
          href="#learn-more"
        )
          i.fa.fa-angle-double-down
          = " "
          = t("Learn more")
          = " "
          i.fa.fa-angle-double-down
  #learn-more.d-block.overflow-hidden.no-search(data-ignore-hash-change)
    include _marketing
  a.text-decoration-none.pt-1.pb-4.pt-lg-4.text-uppercase.text-themed.mx-auto.bounce-animation(
    href="#testimonials"
  )
    i.fa.fa-angle-double-down
    = " "
    = t("Happy Customers")
    = " "
    i.fa.fa-angle-double-down
  include _testimonials
  include _tti
