include my-account/domains/_change-plan-option
include my-account/_list-filters

- const isObjectIdLike = (value) => typeof value === "string" && /^[a-f\d]{24}$/i.test(value);
- const breadcrumbValue = (value) => (_.isObject(value) ? value.name : value);
//- (an alias is called a mailbox, as it is in the sidebar and the domain list:
//- the names and headings that the controllers set are worded here)
- const breadcrumbMailbox = { aliases: t("Mailboxes"), [t("Aliases")]: t("Mailboxes"), [t("Add Alias")]: t("Add Mailbox"), [t("Edit Alias")]: t("Edit Mailbox") };
- const breadcrumbWord = (value) => (Object.prototype.hasOwnProperty.call(breadcrumbMailbox, value) ? breadcrumbMailbox[value] : null);
//- (a domain name or an email address is shown as it is, never reworded; a
//- domain page opened by its id shows the name of the domain)
- const breadcrumbDomain = (value) => (typeof value === "string" && typeof domain === "object" && domain && domain.name && (value === domain.id || value.toLowerCase() === domain.name.toLowerCase() || value.toLowerCase() === punycode.toASCII(domain.name).toLowerCase()) ? domain.name : null);
- const breadcrumbLiteral = (value) => (typeof value === "string" && (value.includes("@") || isFQDN(value)) ? value : null);
- const breadcrumbName = (value) => breadcrumbDomain(breadcrumbValue(value)) || breadcrumbLiteral(breadcrumbValue(value)) || (isObjectIdLike(breadcrumbValue(value)) ? titleize(humanize(breadcrumbValue(value))) : breadcrumbWord(breadcrumbValue(value)) || t(titleize(humanize(breadcrumbValue(value)))));
- const breadcrumbHeader = (value) => (_.isObject(value) && value.header ? breadcrumbWord(value.header) || value.header : breadcrumbName(value));

if breadcrumbs.length > 1
  nav.d-none.d-md-block(aria-label="breadcrumb")
    ol.breadcrumb.justify-content-center.justify-content-md-start.mb-3.py-1.small
      each breadcrumb, i in breadcrumbs
        if i === breadcrumbs.length - 1
          li.breadcrumb-item.active(aria-current="page")
            if _.isObject(breadcrumb) && breadcrumb.href
              a.text-themed(
                href=_.isObject(breadcrumb) ? breadcrumb.href : `/${breadcrumbs.slice(0, i + 1).join("/")}/`
              )
                = breadcrumbName(breadcrumb)
            else
              = breadcrumbName(breadcrumb)
        else
          li.breadcrumb-item
            a.text-themed(
              href=_.isObject(breadcrumb) ? breadcrumb.href : `/${breadcrumbs.slice(0, i + 1).join("/")}/`
            )
              = breadcrumbName(breadcrumb)
  .acct-head.text-center.text-md-left.d-md-flex.my-3
    h1.mb-0(class=breadcrumbHeaderCentered ? "flex-grow-1 text-center" : "")
      if breadcrumbs.length > 0
        = breadcrumbHeader(breadcrumbs[breadcrumbs.length - 1])
      else
        = breadcrumbHeader(breadcrumbs[0])
    if !breadcrumbHeaderCentered
      .flex-grow-1.ml-md-5.d-md-flex.align-items-center.justify-content-md-end.justify-content-center.mt-3.mt-md-0
        if domain && ((domain.has_mx_record && domain.has_txt_record) || domain.plan !== 'free') && (ctx.pathWithoutLocale === `/my-account/domains/${domain.id}` || ctx.pathWithoutLocale === `/my-account/domains/${punycode.toASCII(domain.name)}`)
          ul.list-inline.mb-0
            li.list-inline-item.mb-1
              a.btn.btn-sm.btn-outline-dark(
                href=domain.plan === "free" ? "#" : l(`/my-account/domains/${punycode.toASCII(domain.name)}/aliases`),
                role=domain.plan === "free" ? "button" : false,
                data-target=domain.plan === "free" ? "#modal-upgrade" : false,
                data-toggle=domain.plan === "free" ? "modal" : false
              )
                i.fa.fa-fw.fa-users
                = " "
                = t("Mailboxes")
            if domain.group === 'admin'
              li.list-inline-item.mb-1
                a.btn.btn-sm.btn-outline-dark(
                  href=domain.plan === "free" ? "#" : l(`/my-account/dmarc-reports?domains=${domain.name}`),
                  role=domain.plan === "free" ? "button" : false,
                  data-target=domain.plan === "free" ? "#modal-upgrade-analytics" : false,
                  data-toggle=domain.plan === "free" ? "modal" : false
                )
                  i.fa.fa-fw.fa-shield-alt
                  = " "
                  = t("DMARC Reports")
              li.list-inline-item.mb-1
                a.btn.btn-sm.btn-outline-dark(
                  href=domain.plan === "free" ? "#" : l(`/my-account/analytics?domains=${domain.name}`),
                  role=domain.plan === "free" ? "button" : false,
                  data-target=domain.plan === "free" ? "#modal-upgrade-analytics" : false,
                  data-toggle=domain.plan === "free" ? "modal" : false
                )
                  i.fa.fa-fw.fas.fa-chart-area
                  = " "
                  = t("Analytics")
              li.list-inline-item.mb-1
                a.btn.btn-sm.btn-outline-dark(
                  href=domain.plan === "free" ? "#" : l(`/my-account/logs?domains=${domain.name}`),
                  role=domain.plan === "free" ? "button" : false,
                  data-target=domain.plan === "free" ? "#modal-upgrade-logs" : false,
                  data-toggle=domain.plan === "free" ? "modal" : false
                )
                  i.fa.fa-fw.fa-stream
                  = " "
                  = t("Logs")
              li.list-inline-item.mb-1
                a.btn.btn-sm.btn-outline-dark(
                  href=l(`/my-account/domains/${punycode.toASCII(domain.name)}/advanced-settings`)
                )
                  i.fa.fa-fw.fa-tools
                  = " "
                  = t("Settings")
              li.list-inline-item.mb-1
                .btn-group.btn-group-sm
                  button.btn.btn-sm.btn-outline-dark.dropdown-toggle(
                    type="button",
                    data-toggle="dropdown",
                    data-boundary="window",
                    aria-haspopup="true",
                    aria-expanded="false"
                  )
                    span.d-none.d-md-inline-block= t("Plan")
                    span.d-md-none= t("Plan")
                  .dropdown-menu.dropdown-menu-right
                    h6.dropdown-header= t("Change Plan")
                    each plan in [ 'free', 'enhanced_protection', 'team' ]
                      +changePlanOption(domain, plan)
                        case plan
                          when 'enhanced_protection'
                            i.fa.fa-fw.fa-shield
                            = " "
                            = t("Enhanced Protection")
                          when 'team'
                            i.fa.fa-fw.fa-users
                            = " "
                            = t("Team")
                          default
                            = t("Free")
                            = " ("
                            = t("DNS-based")
                            = ")"
                        if plan === domain.plan
                          = " ("
                          = t("Current")
                          = ")"
                    .dropdown-divider
                    a.dropdown-item.small.text-muted(
                      href=l(`/private-business-email?domain=${domain.name}`)
                    )= t("See all plan features")
        else if domain && (ctx.pathWithoutLocale === `/my-account/domains/${domain.id}/aliases` || ctx.pathWithoutLocale === `/my-account/domains/${punycode.toASCII(domain.name)}/aliases`)
          ul.list-inline.mb-0
            if !domain.is_global && domain.group === 'admin'
              li.list-inline-item.mb-1
                form.ajax-form.confirm-prompt.d-inline-block(
                  action=l(`/my-account/domains/${punycode.toASCII(domain.name)}/aliases/import`),
                  method="POST"
                )
                  button.btn.btn-dark(type="submit")
                    != t('Import <span class="notranslate">TXT</span> Records')
                    = " "
                    i.fa.fa-cloud-download-alt
            if domain.group === 'admin' || (config.ubuntuTeamMapping && !Object.keys(config.ubuntuTeamMapping).includes(domain.name))
              li.list-inline-item.mb-1
                a.btn.btn-dark(
                  href=l(`/my-account/domains/${punycode.toASCII(domain.name)}/aliases/new`),
                  role="button",
                  data-toggle="modal-anchor",
                  data-target="#modal-alias"
                )
                  = t("Mailbox")
                  = " "
                  i.fa.fas.fa-plus-circle
        else
          case ctx.pathWithoutLocale
            when '/my-account/logs'
              ul.list-inline.mb-0
                if !_.isEmpty(ctx.query)
                  li.list-inline-item.mb-1
                    a.btn.btn-dark(href=l("/my-account/logs"))
                      i.fa.fa-filter
                      = " "
                      = t("Clear filters")
                if Array.isArray(responseCodes) && (responseCodes.length > 0 || selectedResponseCodes.length > 0)
                  li.list-inline-item.mb-1
                    +responseCodesFilter(responseCodes, selectedResponseCodes)
                if bounceCategories && bounceCategories.length > 0
                  - const catBaseParams = Object.keys(ctx.query).filter((k) => k !== 'bounce_category' && k !== 'page' && k !== 'limit').map((k) => `${k}=${encodeURIComponent(ctx.query[k])}`).join('&');
                  li.list-inline-item.mb-1
                    .btn-group
                      button.btn.btn-dark.dropdown-toggle(
                        type="button",
                        data-toggle="dropdown",
                        data-boundary="window",
                        aria-haspopup="true",
                        aria-expanded="false"
                      )
                        if ctx.query.bounce_category
                          = t("Category:")
                          = " "
                          = ctx.query.bounce_category === "dmarc" ? "DMARC" : titleize(humanize(ctx.query.bounce_category))
                        else
                          = t("Filter by category")
                      .dropdown-menu
                        h6.dropdown-header= t("Filter by category:")
                        each category in bounceCategories
                          a.dropdown-item(
                            href=l(`/my-account/logs?bounce_category=${category}${catBaseParams ? `&${catBaseParams}` : ""}`)
                          )
                            = category === "dmarc" ? "DMARC" : titleize(humanize(category))
                        if ctx.query.bounce_category
                          .dropdown-divider
                          - const clearCatParams = Object.keys(ctx.query).filter((k) => k !== 'bounce_category' && k !== 'page' && k !== 'limit').map((k) => `${k}=${encodeURIComponent(ctx.query[k])}`).join('&');
                          a.dropdown-item.text-danger(
                            href=l(`/my-account/logs${clearCatParams ? `?${clearCatParams}` : ""}`)
                          )
                            = t("Clear category filter")
                //- Show Errors Only button - filters to only bounced/rejected emails
                - const errBaseParams = Object.keys(ctx.query).filter((k) => k !== 'show_errors' && k !== 'page' && k !== 'limit').map((k) => `${k}=${encodeURIComponent(ctx.query[k])}`).join('&');
                li.list-inline-item.mb-1
                  if ctx.query.show_errors === 'true'
                    a.btn.btn-danger(
                      href=l(`/my-account/logs${errBaseParams ? `?${errBaseParams}` : ""}`)
                    )
                      i.fa.fa-exclamation-triangle
                      = " "
                      = t("Showing Errors Only")
                  else
                    a.btn.btn-outline-danger(
                      href=l(`/my-account/logs?show_errors=true${errBaseParams ? `&${errBaseParams}` : ""}`)
                    )
                      i.fa.fa-exclamation-triangle
                      = " "
                      = t("Show Errors Only")
                li.list-inline-item.mb-1
                  a.btn.btn-dark(
                    href=l("/email-api#tag/logs"),
                    target="_blank"
                  )
                    i.fa.fa-fw.fa-code.text-themed
                    = " "
                    = t("Retrieve via API")
                if logs && logs.length > 0 && itemCount && itemCount > 0
                  li.list-inline-item.mb-1
                    form.ajax-form.confirm-prompt(
                      action=l("/my-account/logs/download"),
                      method="GET",
                      data-confirm-prompt-title=t("Download Log Report"),
                      data-confirm-prompt-html=t('We will send an email to <span class="font-weight-bold text-monospace notranslate">%s</span> when your CSV spreadsheet is ready with <span class="font-weight-bold notranslate">%d</span> log rows.', user.email, itemCount)
                    )
                      if ctx.query && Object.keys(ctx.query).length > 0
                        each key in Object.keys(ctx.query)
                          if key !== 'limit' && key !== 'page'
                            input(
                              type="hidden",
                              name=key,
                              value=ctx.query[key]
                            )
                      button.btn.btn-primary(type="submit")
                        i.fa.fa-file-csv
                        = " "
                        = t("Download Log Report")
            when '/my-account/emails'
              //- (see app/controllers/web/my-account/list-emails.js)
              ul.list-inline.mb-0
                if hasFilters
                  li.list-inline-item.mb-1
                    a.btn.btn-dark(href=l("/my-account/emails"))
                      i.fa.fa-filter
                      = " "
                      = t("Clear filters")
                if Array.isArray(statuses)
                  li.list-inline-item.mb-1
                    .btn-group
                      button.btn.btn-dark.dropdown-toggle(
                        type="button",
                        data-toggle="dropdown",
                        data-boundary="window",
                        aria-haspopup="true",
                        aria-expanded="false"
                      )
                        = t("Status")
                        if statuses.length > 0
                          = ": "
                          = statuses.map((status) => titleize(humanize(status))).join(", ")
                      .dropdown-menu
                        each status in emailStatuses
                          a.dropdown-item(
                            class=statuses.includes(status) ? "active" : "",
                            href=getFilterUrl({ status })
                          )= titleize(humanize(status))
                        if statuses.length > 0
                          .dropdown-divider
                          a.dropdown-item.text-danger(
                            href=getFilterUrl({ status: undefined })
                          )= t("Clear")
                //- (the codes filtered by, from a code in a row: the codes of
                //- all the emails are not looked up, as they are not indexed)
                if Array.isArray(selectedResponseCodes) && selectedResponseCodes.length > 0
                  li.list-inline-item.mb-1
                    +responseCodesFilter([], selectedResponseCodes)
                //- (opens the modal in my-account/emails/index.pug)
                if smtpReputation
                  li.list-inline-item.mb-1
                    button.btn.btn-dark(
                      type="button",
                      data-toggle="modal",
                      data-target="#modal-smtp-reputation"
                    )
                      i.fa.fa-fw.fa-chart-line
                      = " "
                      = t("Outbound SMTP Reputation")
                li.list-inline-item.mb-1
                  a.btn.btn-dark(
                    href=l("/email-api#tag/emails"),
                    target="_blank"
                  )
                    i.fa.fa-fw.fa-code.text-themed
                    = " "
                    = t("Retrieve via API")
            when '/my-account/analytics'
              ul.list-inline.mb-0
                li.list-inline-item.mb-1
                  if user.plan === 'free'
                    button.btn.btn-dark(
                      type="button",
                      data-target="#modal-upgrade-logs",
                      data-toggle="modal"
                    )
                      i.fa.fa-fw.fa-stream
                      = " "
                      = t("Logs")
                  else
                    a.btn.btn-dark(
                      href=l(`/my-account/logs${typeof ctx.query.domains === "string" && ctx.query.domains ? `?domains=${encodeURIComponent(ctx.query.domains)}` : ""}`)
                    )
                      i.fa.fa-fw.fa-stream
                      = " "
                      = t("Logs")
            when '/my-account/domains'
              ul.list-inline.mb-0
                li.list-inline-item.mb-1
                  a.btn.btn-dark(
                    href=l("/my-account/domains/new"),
                    role="button",
                    data-toggle="modal-anchor",
                    data-target="#modal-domain"
                  )
                    = t("Domain")
                    = " "
                    i.fa.fas.fa-plus-circle
                if domains.length > 0 || isSANB(ctx.query.q)
                  li.list-inline-item.mb-1
                    a.btn.btn-dark(
                      href=l("/my-account/domains/aliases/new"),
                      role="button",
                      data-toggle="modal-anchor",
                      data-target="#modal-alias"
                    )
                      = t("Mailbox")
                      = " "
                      i.fa.fas.fa-plus-circle
                if domains.length > 0 || isSANB(ctx.query.q)
                  li.list-inline-item.mb-1
                    if user.plan === 'free'
                      button.btn.btn-dark(
                        type="button",
                        data-target="#modal-upgrade-analytics",
                        data-toggle="modal"
                      )
                        i.fa.fa-fw.fa-shield-alt
                        = " "
                        = t("DMARC Reports")
                    else
                      a.btn.btn-dark(href=l("/my-account/dmarc-reports"))
                        i.fa.fa-fw.fa-shield-alt
                        = " "
                        = t("DMARC Reports")

                  li.list-inline-item.mb-1
                    if user.plan === 'free'
                      button.btn.btn-dark(
                        type="button",
                        data-target="#modal-upgrade-analytics",
                        data-toggle="modal"
                      )
                        i.fa.fa-fw.fas.fa-chart-area
                        = " "
                        = t("Analytics")
                    else
                      a.btn.btn-dark(href=l("/my-account/analytics"))
                        i.fa.fa-fw.fas.fa-chart-area
                        = " "
                        = t("Analytics")
                  li.list-inline-item.mb-1
                    if user.plan === 'free'
                      button.btn.btn-dark(
                        type="button",
                        data-target="#modal-upgrade-logs",
                        data-toggle="modal"
                      )
                        i.fa.fa-fw.fa-stream
                        = " "
                        = t("Logs")
                    else
                      a.btn.btn-dark(href=l("/my-account/logs"))
                        i.fa.fa-fw.fa-stream
                        = " "
                        = t("Logs")
            default
              = " "
