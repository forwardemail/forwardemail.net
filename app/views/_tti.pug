- const isTtiPage = ctx.pathWithoutLocale === "/tti";
- const ttiData = typeof tti === "undefined" ? null : tti;
- const ttiHistory = typeof ttiChartData === "undefined" ? null : ttiChartData;
- const canRenderTti = ttiData && Array.isArray(ttiData.providers) && ttiData.providers.length > 0 && ttiData.providers.every((provider) => provider.directMs > 0 && provider.forwardingMs > 0 && provider.directMs <= 10000 && provider.forwardingMs <= 10000);

if ttiData && (isTtiPage || canRenderTti)
  section#tti.fe-tti.fe-surface-dark(
    data-tti-refresh=isTtiPage ? "true" : undefined
  )
    .fe-tti__container
      .fe-tti__summary
        header.fe-tti__header
          p.fe-tti__eyebrow.fe-label= t("Time to Inbox")
          if isTtiPage
            h1.fe-tti__title= t("Time to Inbox")
          else
            h2.fe-tti__title= t("Time to Inbox")
          //- The intro comes first so the heading is answered by the text
          //- under it. Off the /tti page it also links the monitor's source,
          //- which /tti links from its note further down. (The alert-link
          //- variant of the sentence is the one translated in every locale.)
          p.fe-tti__intro
            = t("We measure these delivery times with our own open-source monitor. It sends test emails to inboxes at major email providers and records how long each one takes to arrive. Our engineers get an alert when a delivery takes longer than 10 seconds.")
            if !isTtiPage
              = " "
              != t('Source code is <a href="https://github.com/forwardemail/forwardemail.net/blob/master/jobs/tti.js" target="_blank" rel="noopener noreferrer" class="alert-link">available on GitHub</a>.')
          p.fe-tti__updated
            != t('Last updated on <span class="dayjs notranslate" data-time="%d">%s</span>', ttiData.created_at.getTime(), dayjs(ttiData.created_at).format("M/D/YY h:mm A z"))

        h2.fe-tti__section-title= t("Current Delivery Times")
        ul.fe-tti__metrics
          each provider in ttiData.providers
            li.fe-tti__metric
              h3.fe-tti__provider= provider.name
              dl.fe-tti__measurement-list
                - const directClass = provider.directMs > 10000 ? "fe-tti__measurement--warning" : "";
                .fe-tti__measurement(class=directClass)
                  dt= t("Direct")
                  dd
                    if provider.directMs === 0
                      i.fa.fa-spin.fa-spinner(aria-label=t("Loading"))
                    else
                      = prettyMilliseconds(provider.directMs)
                - const forwardingClass = provider.forwardingMs > 10000 ? "fe-tti__measurement--warning" : "";
                .fe-tti__measurement(class=forwardingClass)
                  dt= t("Forwarding")
                  dd
                    if provider.forwardingMs === 0
                      i.fa.fa-spin.fa-spinner(aria-label=t("Loading"))
                    else
                      = prettyMilliseconds(provider.forwardingMs)

      if isTtiPage
        .fe-tti__history
          h2.fe-tti__section-title= t("Historical Timeline")
          if ttiHistory
            .fe-tti__chart-data(
              data-json=JSON.stringify(ttiHistory),
              data-labels=JSON.stringify({ time: t("Time (24 Hours)"), average: t("Average Delivery Time"), unavailable: t("N/A") }),
              hidden
            )
          .fe-tti__chart-card
            .fe-tti__chart-head
              h3.fe-tti__chart-title= t("24-Hour Performance by Provider")
              p.fe-tti__chart-description= t("Average delivery times for each email provider")
            //- core.js loads ApexCharts from here when it draws the chart
            #tti-timeline-chart.fe-tti__chart(
              data-tti-chart,
              data-apexcharts-src=config.env === "test" ? `${config.urls.web}/js/apexcharts.js` : manifest("js/apexcharts.js"),
              data-apexcharts-integrity=config.env === "test" ? false : manifest("js/apexcharts.js", "integrity")
            )
          p.fe-tti__note
            strong= t("Did you know?")
            = " "
            = t("We are the only email service with 100% open-source and transparent monitoring.")
            = " "
            != t('Source code is <a href="https://github.com/forwardemail/forwardemail.net/blob/master/jobs/tti.js" target="_blank" rel="noopener noreferrer">available on GitHub</a>.')
