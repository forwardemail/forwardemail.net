//- The site's videos, and the modals, buttons and cards that play them: the
//- two-minute tour on the home page (the hero's Watch button and the card
//- beside the product lede), and on /download the apps video (the hero's
//- Watch button) and the terminal app's video (the card in the Terminal
//- section). Each video has its own modal, so a page can carry more than
//- one. Each button and card is described by its modal's title, so a screen
//- reader can tell them apart.
//-
//- Nothing about a video loads with the page. The <video> has
//- preload="none" and js/video-modal.js sets its poster when the modal
//- opens; the card's image is lazy. MP4 (H.264 + AAC) is the first source
//- and plays in every current browser, and WebM (VP9 + Opus) covers builds
//- without H.264. The captions are part of the picture. A video with a
//- captions file also carries them as a WebVTT track, off by default so they
//- do not double the ones in the picture, for screen readers and the
//- player's captions menu. Without JavaScript, the button and the card are
//- plain links to the MP4.
//-
//- Safari plays a video only from a server that answers byte ranges, which
//- helpers/static-byte-ranges.js adds for static audio and video.

//- Each video's files under img/video/ (an MP4, a WebM, a 1280x720 poster
//- as JPEG and WebP, and for the tour a WebVTT captions file), the title of
//- its modal, its length, the id of its modal, and the
//- hash that opens it from a link (/#video, /download#video-terminal). The
//- tour and the apps video are each the main video of their page, so both
//- open from #video.
-
  const feVideos = {
    tour: {
      file: "forward-email",
      title: t("Forward Email in two minutes"),
      length: "1:58",
      duration: "PT1M58S",
      modal: "modal-video",
      hash: "video",
      captions: true
    },
    apps: {
      file: "forward-email-apps",
      title: t("Forward Email on every device"),
      length: "1:49",
      duration: "PT1M49S",
      modal: "modal-video-apps",
      hash: "video"
    },
    terminal: {
      file: "forward-email-terminal",
      title: t("Forward Email in your terminal"),
      length: "1:44",
      duration: "PT1M44S",
      modal: "modal-video-terminal",
      hash: "video-terminal"
    }
  };
  // The video a mixin names, or the tour when it names none
  const feVideo = (key = "tour") => {
    if (!Object.hasOwn(feVideos, key))
      throw new Error(`_fe-video.pug has no video "${key}"`);
    return feVideos[key];
  };

//- The length of the video, shown on the button and the card
mixin feVideoTime(video)
  time.fe-video-time(datetime=video.duration)= video.length

mixin feVideoPlayGlyph
  svg(viewBox="0 0 24 24", aria-hidden="true", focusable="false")
    path(d="M8 5.5v13l11-6.5z")

mixin feVideoButton(key)
  - const video = feVideo(key);
  a.fe-btn.fe-btn--ghost.fe-btn--lg.fe-video-button(
    href=manifest(`img/video/${video.file}.mp4`),
    data-toggle="modal",
    data-target=`#${video.modal}`,
    aria-haspopup="dialog",
    aria-describedby=`${video.modal}-title`
  )
    span.fe-video-button__icon
      +feVideoPlayGlyph
    = t("Watch the video")
    = " "
    +feVideoTime(video)

mixin feVideoCard(key)
  - const video = feVideo(key);
  a.fe-video-card(
    href=manifest(`img/video/${video.file}.mp4`),
    data-toggle="modal",
    data-target=`#${video.modal}`,
    aria-haspopup="dialog",
    aria-describedby=`${video.modal}-title`
  )
    img.fe-video-card__poster(
      src=manifest(`img/video/${video.file}.webp`),
      alt="",
      width="1280",
      height="720",
      loading="lazy",
      decoding="async"
    )
    span.fe-video-card__play
      +feVideoPlayGlyph
    span.fe-video-card__label
      = t("Watch the video")
      = " "
      +feVideoTime(video)

mixin feVideoModal(key)
  - const video = feVideo(key);
  .modal.fade.fe-video-modal(
    id=video.modal,
    tabindex="-1",
    role="dialog",
    aria-labelledby=`${video.modal}-title`,
    aria-hidden="true",
    data-video-hash=video.hash
  )
    .modal-dialog.modal-dialog-centered.modal-xl(role="document")
      .modal-content
        .modal-header
          h2.modal-title.h5(id=`${video.modal}-title`)= video.title
          button.close(
            type="button",
            data-dismiss="modal",
            aria-label=t("Close")
          )
            span(aria-hidden="true") &times;
        .modal-body
          video.fe-video__player(
            controls,
            playsinline,
            preload="none",
            width="1920",
            height="1080",
            data-poster=manifest(`img/video/${video.file}.jpg`)
          )
            source(
              src=manifest(`img/video/${video.file}.mp4`),
              type="video/mp4; codecs=\"avc1.640028, mp4a.40.2\""
            )
            source(
              src=manifest(`img/video/${video.file}.webm`),
              type="video/webm; codecs=\"vp9, opus\""
            )
            if video.captions
              track(
                kind="captions",
                srclang="en",
                label="English",
                src=manifest(`img/video/${video.file}.vtt`)
              )
            a(href=manifest(`img/video/${video.file}.mp4`))= t("Download the video (MP4)")
        .modal-footer
          a.fe-video__download(
            href=manifest(`img/video/${video.file}.mp4`),
            download=`${video.file}.mp4`
          )
            i.fa.fa-download(aria-hidden="true")
            = t("Download the video (MP4)")
