extends layout

include _fe-page-header

block body
  //- Dark, centred, one action, on the shared status mixin. The article
  //- illustration this page used to show is hidden site-wide for now.
  .fe-landing
    +feStatus("404", t("Page not found"), t("We're sorry, but the page you requested could not be found."))
      form(action="/", type="GET")
        button.fe-btn.fe-btn--hero.fe-btn--lg(type="submit")
          i.fa.fa-home(aria-hidden="true")
          = t("Go to homepage")
      a.fe-btn.fe-btn--ghost.fe-btn--lg(href=l("/faq"))
        i.fa.fa-life-ring(aria-hidden="true")
        = t("Frequently Asked Questions")
