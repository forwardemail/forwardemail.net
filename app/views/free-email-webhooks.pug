extends layout

include _fe-page-header
include _fe-onboard

block body
  - const hash = "do-you-support-webhooks";
  //- Was: the auto-opening onboarding modal, then a centred h1 with an
  //- uppercase kicker and one button. Now the shared fe page header with
  //- the same button, and the onboarding form inline at the foot for a
  //- logged out visitor (see _fe-onboard.pug).
  .fe-landing(class=isFeFlushNav ? "fe-landing--flush" : "")
    +fePageHeader({ id: "fe-webhooks", icon: "fa fa-plug", eyebrow: t("Setup an email webhook in minutes"), title: t("Email webhooks"), body: t("Easily set up webhooks for email delivery.") })
      .fe-actions.fe-page-header__actions
        a.fe-btn.fe-btn--hero.fe-btn--lg.fe-btn--glow(href=l(`/faq#${hash}`))
          = t("Create free email webhooks")
          i.fa.fa-angle-right(aria-hidden="true")
        a.fe-btn.fe-btn--ghost.fe-btn--lg(href=l("/email-api"))
          i.fa.fa-code(aria-hidden="true")
          = t("Read the API reference")
    if !user
      +feOnboard(t('Need email forwarding webhooks?'), t('Skip ahead to the instructions to forward emails to webhooks.'), l(`/faq?hash=${hash}`), l(`/faq#${hash}`))
