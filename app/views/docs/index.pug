extends ../layout

include ../_fe-page-header
include ../_fe-cards

block body
  //- Was: bootstrap cards on the stars parallax. Same list (the three
  //- developer tools, then every developer doc), same destinations, same
  //- images, on the fe page header and the shared card grid.
  - const tools = [];
  - const list = ["/email-api", "/free-email-webhooks", "/email-forwarding-regex-pattern-filter"];
  each item in list
    - const match = config.meta[item];
    if match
      - tools.push({ title: match[0].replace(config.metaTitleAffix, ""), description: match[1], slug: item });
  each developerDoc in developerDocs
    - tools.push(developerDoc);
  .fe-landing(class=isFeFlushNav ? "fe-landing--flush" : "")
    +fePageHeader({ id: "fe-docs", icon: "fa fa-code", eyebrow: t("Developers"), title: t("Free Email Developer Tools and Resources"), body: t("Developer-focused email API, tools, and resources to send email, trigger webhooks, forward messages, and more.") })
      .fe-page-header__meta
        +feByline
    section.fe-section.fe-surface-light.fe-section--pad-sm.fe-body.no-search
      .fe-container
        ul.fe-grid.fe-grid--md-2.fe-grid--lg-3
          each doc, i in tools
            +feCard({ title: t(doc.title), description: t(doc.description), href: l(doc.slug), alt: striptags(t(doc.title)), image: doc.ogImage ? manifest(doc.ogImage) : l(`${doc.slug}.png`), eager: i <= 2, cta: doc.ogBtnText })
