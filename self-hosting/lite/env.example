#
# .env for `self-hosting/lite/docker-compose.yml`: copy it to `.env` next to
# the compose file, replace mail.example.com and generate the secrets (the
# `forwardemail-selfhost init` CLI writes this file for you).
#
# Only what differs from the image's `.env.defaults` is set here.
#

# the one hostname for MX, IMAP, SMTP and the web interface (also read by
# docker compose itself, for the container's hostname and extra_hosts)
MAIL_HOST=mail.example.com
# image tag, e.g. v2.19.21 (default: latest)
FE_VERSION=latest

NODE_ENV=production
SELF_HOSTED=true
APP_NAME=mail.example.com

#
# hosts and ports: every process runs in the app container, where MAIL_HOST
# resolves to 127.0.0.1 (see `extra_hosts`)
#
HTTP_PROTOCOL=https
WEB_HOST=mail.example.com
WEB_PORT=3000
WEB_URL=https://mail.example.com
API_HOST=mail.example.com
CALDAV_HOST=mail.example.com
CARDDAV_HOST=mail.example.com
SQLITE_HOST=mail.example.com
SQLITE_PORT=3456
SQLITE_STORAGE_PATH=sqlite_storage
MX_HOST=mail.example.com
MX_PORT=25
MX1_HOST=mail.example.com
MX2_HOST=mail.example.com
SMTP_EXCHANGE_DOMAINS=mail.example.com
SMTP_HOST=mail.example.com
SMTP_PORT=465
IMAP_HOST=mail.example.com
IMAP_PORT=993
POP3_HOST=mail.example.com
POP3_PORT=995

# the other containers on the compose network
MONGO_HOST=mongodb
LOGS_HOST=mongodb
REDIS_HOST=redis

#
# TLS (one certificate for MAIL_HOST) and the DKIM key of the system mail
# (account verification and the like, sent from addresses at MAIL_HOST)
#
SSL_KEY_PATH=/app/ssl/privkey.pem
SSL_CERT_PATH=/app/ssl/fullchain.pem
SSL_CA_PATH=/app/ssl/chain.pem
WEB_SSL_KEY_PATH=/app/ssl/privkey.pem
WEB_SSL_CERT_PATH=/app/ssl/fullchain.pem
WEB_SSL_CA_PATH=/app/ssl/chain.pem
API_SSL_KEY_PATH=/app/ssl/privkey.pem
API_SSL_CERT_PATH=/app/ssl/fullchain.pem
API_SSL_CA_PATH=/app/ssl/chain.pem
CALDAV_SSL_KEY_PATH=/app/ssl/privkey.pem
CALDAV_SSL_CERT_PATH=/app/ssl/fullchain.pem
CALDAV_SSL_CA_PATH=/app/ssl/chain.pem
CARDDAV_SSL_KEY_PATH=/app/ssl/privkey.pem
CARDDAV_SSL_CERT_PATH=/app/ssl/fullchain.pem
CARDDAV_SSL_CA_PATH=/app/ssl/chain.pem
DKIM_PRIVATE_KEY_PATH=/app/ssl/dkim.key

#
# secrets: generate each once and keep a copy of this file somewhere safe,
# mailboxes and stored credentials cannot be read without them
#
# openssl rand -hex 16
HELPER_ENCRYPTION_KEY=
# openssl rand -hex 16
SRS_SECRET=
# openssl rand -hex 32
API_SECRETS=
# openssl rand -hex 16
TXT_ENCRYPTION_KEY=
# openssl rand -hex 16
WEBHOOK_SIGNATURE_KEY=

#
# mail
#
SEND_EMAIL=true
PREVIEW_EMAIL=false
TRANSPORT_DEBUG=false

#
# small box: no SaaS-only services, one spam scanner thread
#
TURNSTILE_ENABLED=false
ENABLE_MONITOR_SERVER=false
AUTH_BASIC_ENABLED=false
CACHE_RESPONSES=true
I18N_SYNC_FILES=false
I18N_UPDATE_FILES=false
SPAM_SCANNER_THREADS=1
SPAM_SCANNER_SEND_THREADS=1
SPAM_SCANNER_MAX_MEMORY=256
SPAM_SCANNER_CLAMAV=false
SQLITE_CACHE_SIZE_KB=8192
# each job worker loads the app (about 250 MB): run two at a time, and hold
# back or stop jobs by small-box thresholds instead of the defaults' (at least
# 2 GB and 1 GB free, which a 4 GB box never has)
BREE_MAX_CONCURRENT_JOBS=2
BREE_PAUSE_BELOW_MB=384
BREE_STOP_BELOW_MB=192
BREE_WORKER_MAX_OLD_SPACE_MB=768
