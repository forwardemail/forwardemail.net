FROM node:20-slim AS builder

WORKDIR /app

ENV SELF_HOSTED=true

# Install build tools required by native Node.js modules that use node-gyp
# (diskusage, iconv, node-snowball, re2, better-sqlite3-multiple-ciphers, etc.)
# Also includes libcurl4-openssl-dev for node-libcurl's fallback-to-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ libcurl4-openssl-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# `package.json` declares `pnpm.patchedDependencies`, so the referenced patch
# files must be present before install -- otherwise `pnpm install` aborts with
# `ENOENT: ... patches/<pkg>.patch`. Copy them alongside the manifests so this
# step still caches on dependency changes only.
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile

COPY . ./

# The asset build imports config/env in production mode, but the runtime .env is
# intentionally excluded from the image build context. Supply a non-runtime
# placeholder only for this build command; deployers must still provide their
# own API_SECRETS when running the final image.
RUN API_SECRETS=build-only-api-secret-000000000000 NODE_ENV=production pnpm run build

## build everything in the first stage and then
## leverage .dockerignore and 2nd stage to remove files
## from the built image that we don't want included
FROM node:20-slim

WORKDIR /app

ENV SELF_HOSTED=true
ENV NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
    dnsutils netcat-traditional curl openssl ca-certificates libcap2-bin && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# TODO: this needs to come from or sync with env file (e.g. SQLITE_TMPDIR)
RUN mkdir -p /mnt/sqlite_storage

COPY --from=builder /app /app

# Create a non-root user and set ownership
# (with a fixed uid and gid, which `setup.sh` gives the mounted certificates,
# keys and mailboxes to)
RUN groupadd -r -g 999 forwardemail && \
    useradd -r -u 999 -g forwardemail -d /app forwardemail && \
    chown -R forwardemail:forwardemail /app /mnt/sqlite_storage

# The servers listen on ports below 1024 (e.g. 25, 465 and 993)
# on the host network as this user, which needs this capability for it
RUN setcap cap_net_bind_service=+ep "$(readlink -f "$(command -v node)")"

USER forwardemail
