#!/usr/bin/env node

/**
 * PM2 error notification helper.
 *
 * Alerts are delegated to the shared host-local sender, which rate limits by
 * application and queues directly to recipient MX servers through send-only
 * Postfix.  This path has no dependency on application SMTP or MongoDB.
 */

const { execFile } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const { promisify } = require('node:util');

const execFileAsync = promisify(execFile);
const ALERT_SENDER = '/usr/local/bin/send-rate-limited-email.sh';

async function sendErrorNotification(
  appName,
  errorMessage,
  errorStack,
  logFile
) {
  const hostname = os.hostname();
  const timestamp = new Date().toISOString();

  let recentLogs = 'Log file not available';
  if (logFile && fs.existsSync(logFile)) {
    try {
      const logContent = fs.readFileSync(logFile, 'utf8');
      recentLogs = logContent.split('\n').slice(-50).join('\n');
    } catch (err) {
      recentLogs = `Error reading log file: ${err.message}`;
    }
  }

  const subject = `[PM2 ERROR] ${appName} on ${hostname}`;
  const text = `PM2 Process Error Alert

Application: ${appName}
Hostname: ${hostname}
Timestamp: ${timestamp}

=== ERROR MESSAGE ===
${errorMessage}

=== STACK TRACE ===
${errorStack || 'No stack trace available'}

=== RECENT LOGS (Last 50 lines) ===
${recentLogs}

This is an automated alert from PM2 error monitoring.
`;

  try {
    await execFileAsync(
      ALERT_SENDER,
      [`pm2-${appName}`, subject, text],
      { maxBuffer: 2 * 1024 * 1024 }
    );
    console.log(`Error notification queued for ${appName}`);
  } catch (err) {
    console.error(`Failed to queue error notification for ${appName}:`, err);
    throw err;
  }
}

module.exports = { sendErrorNotification };

if (require.main === module) {
  const appName = process.argv[2] || 'unknown';
  const errorMessage = process.argv[3] || 'Unknown error';
  const errorStack = process.argv[4] || '';
  const logFile = process.argv[5] || '';

  sendErrorNotification(appName, errorMessage, errorStack, logFile)
    .then(() => process.exit(0))
    .catch(() => process.exit(1));
}
