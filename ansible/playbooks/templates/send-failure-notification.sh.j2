#!/bin/bash
# Send an email and optional Twilio SMS when a systemd unit fails.
# Usage: send-failure-notification.sh <unit-name>

set -uo pipefail

if [[ "$#" -ne 1 ]] || ! [[ "$1" =~ ^[A-Za-z0-9_.@:-]+$ ]]; then
  printf 'Usage: %s <unit-name>\n' "$0" >&2
  exit 64
fi

UNIT_NAME="$1"
ALERT_KEY="${UNIT_NAME%.service}"
HOST_NAME="$(hostname -f 2>/dev/null || hostname)"
TIMESTAMP="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

STATUS=$(timeout --signal=TERM 10 systemctl status --no-pager --full -n 50 "$UNIT_NAME" 2>&1 || true)
LOGS=$(timeout --signal=TERM 10 journalctl -u "$UNIT_NAME" -n 50 --no-pager --output=short-iso 2>&1 || true)
SUBJECT="[ALERT] Service Failure: $UNIT_NAME on $HOST_NAME"
BODY="Service $UNIT_NAME failed on $HOST_NAME at $TIMESTAMP.

=== SERVICE STATUS ===
$STATUS

=== RECENT LOGS ===
$LOGS

This is an automated infrastructure alert."

/usr/local/bin/send-rate-limited-email.sh "$ALERT_KEY" "$SUBJECT" "$BODY" || {
  rc=$?
  logger -t forwardemail-alert -- "key=$ALERT_KEY centralized_delivery_failed rc=$rc" 2>/dev/null || true
}

# Never let a notification-channel failure recursively fail the OnFailure unit.
exit 0
