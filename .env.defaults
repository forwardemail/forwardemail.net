#########################
## CUSTOMER SUPPORT AI ##
#########################
# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2000
LANCEDB_PATH=
# Forward Email API (for customer support inbox monitoring)
FORWARD_EMAIL_ALIAS_USERNAME=
FORWARD_EMAIL_ALIAS_PASSWORD=
# Processing
CUSTOMER_SUPPORT_AI_INBOX_LIMIT=100
# Historical Email Training
HISTORY_SCAN_LIMIT=1000
HISTORY_SCAN_SINCE=2023-01-01
HISTORY_DECRYPT_PGP=true
INBOX_ZERO=false

#################
## X (Twitter) ##
#################
# X/Twitter user ID for @fwdemail (used for RSS feed and calendar integration)
# IMPORTANT: Use backticks to preserve as string (prevents JavaScript number precision loss)
X_USER_ID=`1347581552339914756`
# X API v2 Bearer Token (get from https://developer.x.com/en/portal/dashboard)
X_API_BEARER_TOKEN=
# X API cache duration (default: 6h to minimize API costs)
# 10 requests = $0.03, so at 6h cache = ~$0.36/month
X_API_CACHE_DURATION=30m

# WebSocket trust proxy — set to true behind a reverse proxy to read X-Forwarded-For
WS_TRUST_PROXY=false

# Mail app (mail.forwardemail.net) release poll interval
# How often to check GitHub for new releases (default: 15m)
MAIL_APP_RELEASE_POLL_INTERVAL=15m

# ManageSieve
MANAGESIEVE_HOST=0.0.0.0
MANAGESIEVE_PORT=4190
SIEVE_MAX_SCRIPT_SIZE=
SIEVE_MAX_SCRIPTS=


# Domain Connect integration
# <https://domainconnect.org/>
# <https://developers.cloudflare.com/dns/reference/domain-connect/>
# The template file is at assets/.well-known/domain-connect/{providerId}.{serviceId}.json
# and must also be submitted to: <https://github.com/Domain-Connect/Templates>
DOMAIN_CONNECT_PROVIDER_ID=forwardemail.net
DOMAIN_CONNECT_PROVIDER_NAME="Forward Email"
DOMAIN_CONNECT_SERVICE_ID=email
DOMAIN_CONNECT_SERVICE_NAME="Email (Forwarding + SMTP)"
DOMAIN_CONNECT_LOGO_URL="https://forwardemail.net/img/logo-square.svg"
DOMAIN_CONNECT_DESCRIPTION="Configure your domain for email forwarding and outbound SMTP with Forward Email."
# syncPubKeyDomain: domain where the public key TXT record is published for signing sync requests
# Cloudflare requires syncPubKeyDomain and a signed apply URL (synchronous flow only)
DOMAIN_CONNECT_SYNC_PUB_KEY_DOMAIN=forwardemail.net
# syncKeyId: the DNS host prefix where the public key TXT records are published
# The DNS provider looks up {syncKeyId}.{syncPubKeyDomain} to fetch the public key
DOMAIN_CONNECT_SYNC_KEY_ID=_dck1
# privateKey: RSA private key (PEM) used to sign synchronous Domain Connect apply requests
# Required for Cloudflare; optional for other providers. Leave blank to skip signing.
# Generate with: openssl genrsa 2048
# Then convert to single-line for env: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' domain-connect-private.key
DOMAIN_CONNECT_PRIVATE_KEY=

# Push notifications (APNs / FCM / UnifiedPush)
# Used by helpers/send-push-notification.js for alias-scoped push delivery
# in parallel with WebSocket delivery, including when no socket is connected.
# APNs (Apple Push Notification service) — token-based auth (.p8 key)
# Reuses APPLE_TEAM_ID, APPLE_KEY_ID, and APPLE_KEY_PATH from the Apple block.
# Generate the shared key at: https://developer.apple.com/account/resources/authkeys/list
# App bundle identifier (must match the Tauri iOS build)
APNS_BUNDLE_ID=net.forwardemail.mail
# Set to "true" for production APNs gateway, "false" or empty for sandbox
APNS_PRODUCTION=false
# FCM (Firebase Cloud Messaging) — HTTP v1 API via service account
# Create at: https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk
FCM_PROJECT_ID=
# Uploaded by ansible/playbooks/certificates.yml beside the shared Apple .p8 key
FCM_SERVICE_ACCOUNT_PATH=/var/www/production/firebase-service-account.json
# UnifiedPush (Web Push encryption and VAPID authentication)
# Generate one stable pair: pnpm exec web-push generate-vapid-keys
VAPID_SUBJECT=mailto:support@forwardemail.net
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
