SMTP_SPAM_SUSPENSION_VIRUS_THRESHOLD=2
SMTP_SPAM_SUSPENSION_MIN_UNIQUE_RECIPIENTS=2
# unauthenticated legacy-HELO mail from generic (provider-generated) reverse DNS
# that impersonates its From domain (see helpers/is-high-confidence-generic-rdns-spam.js)
# is rejected; set to true to only log and count it
GENERIC_RDNS_SPAM_MONITOR_ONLY=false
# unauthenticated mail from an address without forward-confirmed reverse DNS
# whose sending domain's SPF fails or softfails (see
# helpers/is-high-confidence-unconfirmed-rdns-spam.js) is rejected; set to true
# to only log and count it
UNCONFIRMED_RDNS_SPAM_MONITOR_ONLY=false
# unauthenticated mail submitted by root on the sending server under an
# unrelated From domain (see helpers/is-high-confidence-root-script-spam.js) is
# rejected; set to true to only log and count it
ROOT_SCRIPT_SPAM_MONITOR_ONLY=false
MAX_RECIPIENTS=50

#################
## spamscanner ##
#################
# Spam Scanner (https://spamscanner.net) scans inbound (MX) and outbound
# (SMTP and API) mail in worker threads, see helpers/spam-scanner.js
# (false: no scans, except of outbound mail for what blocks it, see
# SPAM_SCANNER_OUTBOUND_BLOCK and SPAM_SCANNER_MONITOR_ONLY)
# (mail from or only to our own domain, WEB_HOST, is never scanned)
SPAM_SCANNER_ENABLED=true
# true (unless explicitly false): never reject, block, defer or file a message
# as spam for anything Spam Scanner or its language model finds, inbound or
# outbound, nor for a scan that fails; only log what it would mark as spam or
# block ("[SPAM_SCANNER]" in the console, with the results, envelope sender,
# From address and subject) and add X-Spam-Scanner-* headers to inbound mail;
# false: outbound mail is blocked for viruses, program attachments, links to
# malware or adult sites and the GTUBE test string
SPAM_SCANNER_MONITOR_ONLY=true
# (only with SPAM_SCANNER_MONITOR_ONLY=false)
# true: outbound spam is only logged; false: outbound mail at the reject
# threshold (Spam Scanner's "reject", 15 by default) is rejected as smtp-bree
# sends it, with a bounce to its sender (not auto-replies, bounces and
# redirects, nor the rest of a message partly sent)
SPAM_SCANNER_OUTBOUND_MONITOR_ONLY=true
# true (unless explicitly false): outbound mail with a virus, a program
# attachment, a link to a malware or adult site or the GTUBE test string is
# refused as it is submitted (SMTP and API, a permanent error, and the domain's
# admins are emailed), in monitor mode too, as before Spam Scanner 7; false:
# in monitor mode it is only logged (out of monitor mode it is always refused)
SPAM_SCANNER_OUTBOUND_BLOCK=true
# add X-Spam-Scanner-* headers to inbound mail
SPAM_SCANNER_HEADERS=true
# the percentage of inbound mail (MX) scanned, 0 to 100, each message picked at
# random (0: none, 100: all; out of monitor mode too, so set it to 100 before
# relying on inbound verdicts); outbound mail is always scanned for what blocks
# it; read when the MX server starts, so change it and restart the MX servers
# to scale scanning up or down without a deploy
SPAM_SCANNER_MX_PERCENT=10
# how often each process writes a "[SPAM_SCANNER] stats" line to the console,
# by where mail was scanned (received, submitted, sending): scans made,
# skipped (not picked, too large, busy), expired in the queue, timed out,
# stopped and failed, MX deliveries made before their scan was done, spam and
# blocking verdicts, how long scans took (average, median, 95th and 99th
# percentile, slowest; in all, waiting for a worker, on it, and asking the
# language model), and errors and warnings written; counted by scan, so a close
# call scanned again with the language model as it is sent counts twice
# (0 or off: never; at most 1d)
SPAM_SCANNER_STATS_INTERVAL=1m
# worker threads per process (each loads the classifier, about 60 MB) and the
# most memory each may use (MB)
SPAM_SCANNER_THREADS=1
SPAM_SCANNER_MAX_MEMORY=512
# worker threads for smtp-bree, which scans outbound mail as it is sent with
# the language model (one scan waiting on it lets another go on)
SPAM_SCANNER_SEND_THREADS=2
# scans waiting for a worker (and as smtp-bree sends mail, for one of its own),
# beyond which messages go unscanned (out of monitor mode, outbound mail is
# then held back with a temporary error)
SPAM_SCANNER_MAX_QUEUE=50
# the most a scan that only logs (inbound mail, and outbound mail in monitor
# mode) may take before mail goes on without it, and each of its network
# checks (link lookups; the time limit is 22s at most; every duration here
# of less than 100ms, e.g. 0, keeps its default)
SPAM_SCANNER_TIMEOUT=8s
SPAM_SCANNER_NETWORK_TIMEOUT=2s
# in monitor mode, the most the MX server waits for the scan of a message it
# received (after looking up its recipients) before it delivers it without the
# X-Spam-Scanner-* headers; the scan goes on and is logged (out of monitor mode
# it waits up to SPAM_SCANNER_TIMEOUT)
SPAM_SCANNER_MX_WAIT=1s
# the same for scans that decide what is blocked (outbound mail out of monitor
# mode, and as it is submitted in it with SPAM_SCANNER_OUTBOUND_BLOCK; the time
# limit is 22s at most)
SPAM_SCANNER_OUTBOUND_TIMEOUT=20s
SPAM_SCANNER_OUTBOUND_NETWORK_TIMEOUT=5s
# (only with SPAM_SCANNER_MONITOR_ONLY=false)
# true: an outbound message that could not be checked (the scan failed or took
# too long, or not every link host could be looked up) gets a temporary error
# and is tried again later; false: it is sent unchecked (also as smtp-bree
# sends it)
SPAM_SCANNER_OUTBOUND_FAIL_CLOSED=true
# larger messages are not scanned by scans that only log (0: no limit)
SPAM_SCANNER_MAX_SIZE=25MB
# ask Cloudflare's malware (1.1.1.2) and family (1.1.1.3) resolvers about link
# hosts (empty: on, except in tests)
SPAM_SCANNER_CLOUDFLARE=
# scan attachments with clamd on its default socket
SPAM_SCANNER_CLAMAV=false
# a language model for close calls on inbound mail (MX) and on outbound mail
# as it is sent (smtp-bree): Ollama on each MX and SMTP server, on 127.0.0.1
# (see ansible/playbooks/spamscanner-llm.yml)
SPAM_SCANNER_LLM_PORT=11436
# (empty: http://127.0.0.1:SPAM_SCANNER_LLM_PORT, except in tests)
SPAM_SCANNER_LLM_URL=
# (only for a server that requires one; one that reads as a number, e.g.
# 0x12 or 1e5, or has a comma in it, or ends with "*", is written in
# backticks so it is kept as written)
SPAM_SCANNER_LLM_API_KEY=
# ollama, llamacpp, vllm, lmstudio, openai-compatible, ... (see
# https://spamscanner.net/docs/llm/)
SPAM_SCANNER_LLM_PROVIDER=ollama
# the model asked for: on the servers, made by Ansible from the base model
# below with half the server's CPUs (see ansible/playbooks/spamscanner-llm.yml)
SPAM_SCANNER_LLM_MODEL=spamscanner
# (Ansible) a model that answers in a second or two on a CPU without a GPU
# (Gemma 4 E2B); qwen3.5:0.8b is faster and less accurate,
# qwen3.5:4b more accurate and slower
SPAM_SCANNER_LLM_BASE_MODEL=gemma4:e2b
# (Ansible) the most memory Ollama may use
SPAM_SCANNER_LLM_MEMORY_MAX=8G
# (Ansible) true: pull the base model again (otherwise only when missing)
SPAM_SCANNER_LLM_PULL=false
# auto (only close calls), always or off (no language model; also false, 0 or
# no; any other value is auto)
SPAM_SCANNER_LLM_MODE=auto
# the most a language model answer may take
SPAM_SCANNER_LLM_TIMEOUT=3s
# characters of a message the model reads (the headers summary, then the body)
SPAM_SCANNER_LLM_MAX_INPUT_CHARS=1500
# remove personal data before a message goes to the model (empty: unless the
# server is this machine)
SPAM_SCANNER_LLM_REDACT=
# how long Ollama keeps the model loaded after a request (-1m: always; 0: it is
# unloaded after each; a bare number is seconds)
SPAM_SCANNER_LLM_KEEP_ALIVE=-1m

#########
## arf ##
#########
# abuse reports (ARF, RFC 5965) from mailbox providers' feedback loops to
# EMAIL_ABUSE are read by the MX server and not delivered: a report about a
# message a user sent counts against their outbound SMTP reputation, as a
# truth source's spam verdict does, and a message reported as spam is learned
# by every server's Spam Scanner classifier (through Redis); only a report to
# EMAIL_ABUSE alone, from an address in ARF_REPORTERS, passing DMARC, whose
# root domain is in TRUTH_SOURCES (other mail to EMAIL_ABUSE, and a report
# that cannot be read or handled, is delivered as before)
# (true unless explicitly false)
ARF_ENABLED=true
# feedback loop addresses, comma-separated: an address, or "@" and a domain
# for any address at that domain itself (Yahoo's and Microsoft's by default)
ARF_REPORTERS=feedback@arf.mail.yahoo.com,scomp-feedback@arf.mail.yahoo.com,staff@hotmail.com
# learn messages reported as spam (true unless explicitly false)
ARF_LEARN=true
# block the sender of mail we forwarded that its recipient reported, for that
# alias's forwarding address alone (a temporary error, for 90 days; listed on
# the alias's page, where it can be lifted); only senders that passed DMARC, by
# their From address, and only for aliases (not catch-alls or regular
# expressions) on paid domains (true unless explicitly false)
ARF_RECIPIENT_BLOCK=true

