#############################
## sqlite websocket server ##
#############################
SQLITE_STORAGE_PATH='storage_do_1'
SQLITE_TMPDIR=/tmp/{{NODE_ENV}}_{{SQLITE_STORAGE_PATH}}_tmp
SQLITE_HOST=localhost
SQLITE_PORT=3456
SQLITE_RCLONE_ENABLED=false
SQLITE_FTS5_ENABLED=false
# legacy auto-vacuum migration by VACUUM INTO + atomic rename (helpers/safe-vacuum.js);
# superseded by SQLITE_VACUUM_ENABLED below
SQLITE_AUTO_VACUUM_MIGRATION_ENABLED=false
# in-place compaction of mailboxes by the sqlite-worker (helpers/compact-database.js)
SQLITE_VACUUM_ENABLED=true
# largest mailbox (live data) compacted to reclaim space
# (mailboxes at auto_vacuum=NONE are converted whatever their size)
SQLITE_VACUUM_MAX_SIZE=512MB
# largest mailbox converted from auto_vacuum=NONE (empty: no limit; the
# conversion holds the mailbox's write lock for ~5-12s per GB, once)
SQLITE_VACUUM_CONVERT_MAX_SIZE=
SQLITE_VERBOSE=false
SQLITE_DEBUG_TIMERS=false
# times each SQL statement the sqlite worker runs for the "stmt" action:
# logs [SLOW_STMT] over SQLITE_STMT_SLOW_MS and a [STMT_TALLY] of the busiest
# query shapes every SQLITE_STMT_TALLY_INTERVAL (SQL text only, never values)
SQLITE_STMT_TIMERS=false
SQLITE_STMT_SLOW_MS=50
SQLITE_STMT_TALLY_INTERVAL=1m
DATABASE_MAP_MAX_SIZE=500
SQLITE_CACHE_SIZE_KB=16384
IMAP_NOTIFY_DEBOUNCE_MS=100
IMAP_NOTIFY_MAX_DELAY_MS=1000

