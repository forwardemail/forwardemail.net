+        let str = this.headers.toString('binary');
+        let end = str.length;
+        while (end > 0 && (str.charCodeAt(end - 1) === 0x0d || str.charCodeAt(end - 1) === 0x0a)) {
+            end--;
+        }
+
+        let rawLines = str.slice(0, end).split(/\r?\n/);
+        let isFolding =
+            typeof this._isFoldingChar === 'function' ? chr => this._isFoldingChar(chr) : chr => chr === ' ' || chr === '\t';
+
+        let groups = [];
+        for (let i = 0; i < rawLines.length; i++) {
+            if (i && groups.length && isFolding(rawLines[i].charAt(0))) {
+                groups[groups.length - 1].push(rawLines[i]);
