header.email-header
  .container
    .row
      .col-12.text-center
        //- only the mark is a link: readers that color every link (webmail,
        //- dark modes) would otherwise turn the wordmark blue
        a.email-brand-link(href=config.urls.web)
          img.email-brand-mark(
            src=manifest("img/logo-square-180x180.png"),
            width=32,
            height=32,
            alt=""
          )
        span.email-brand Forward Email
