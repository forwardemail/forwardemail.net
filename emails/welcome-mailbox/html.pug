extends ../layout

block content
  -
    const mailboxSections = [
      {
        title: t("Get Started"),
        links: [
          {
            href: "https://mail.forwardemail.net",
            text: t("Open the web app"),
            external: true
          },
          {
            href: `${config.urls.web}/${locale}/download`,
            text: t("Desktop and mobile apps")
          },
          {
            href: `${config.urls.web}/${locale}/faq#do-you-support-receiving-email-with-imap`,
            text: t("Email Client Setup")
          },
          {
            href: `${config.urls.web}/${locale}/faq#how-do-i-import-and-migrate-my-existing-mailbox`,
            text: t("Import & Migrate Your Mailbox")
          }
        ]
      },
      {
        title: t("Manage Your Account"),
        links: [
          {
            href: `${config.urls.web}/${locale}/my-account/domains`,
            text: t("Create Aliases & Mailboxes")
          },
          {
            href: `${config.urls.web}/${locale}/my-account/security`,
            text: t("Account Security & Profile")
          },
          {
            href: `${config.urls.web}/${locale}/my-account/billing`,
            text: t("Billing & Plans")
          }
        ]
      },
      {
        title: t("Learn More"),
        links: [
          {
            href: `${config.urls.web}/${locale}/faq`,
            text: t("FAQ")
          },
          {
            href: `${config.urls.web}/pentest-report_forward-email.pdf`,
            text: t("Security Audit"),
            external: true
          },
          {
            href: `${config.urls.web}/technical-whitepaper.pdf`,
            text: t("Technical Whitepaper (PDF)"),
            external: true
          },
          {
            href: `${config.urls.web}/${locale}/faq#do-you-support-self-hosting`,
            text: t("Self-Hosting Guide")
          }
        ]
      },
      {
        title: t("Connect With Us"),
        links: [
          {
            href: `${config.urls.web}/${locale}/help`,
            text: t("Support & Help")
          },
          {
            href: "https://matrix.to/#/#forwardemail:matrix.org",
            text: t("Matrix Chat Room"),
            external: true
          },
          {
            href: "https://x.com/fwdemail",
            text: t("@fwdemail on X (Twitter)"),
            external: true
          },
          {
            href: "https://github.com/forwardemail",
            text: t("GitHub"),
            external: true
          }
        ]
      }
    ];
  .container.mt-3
    .row
      .col-12
        .card.border-dark.d-block.text-center
          h1.h5.card-header= t("Welcome to Forward Email")
          .card-body.text-center.p-0
            .p-3
              p.card-text.mb-0= t("Your encrypted mailbox is ready.")
              if aliasAddress
                p.card-text.mt-2.mb-0
                  strong= aliasAddress
            each section, index in mailboxSections
              .p-3(class=index % 2 === 0 ? "bg-light" : undefined)
                h2.h4= section.title
                ul.list-inline.mb-0
                  each link in section.links
                    li.list-inline-item.mb-2
                      a.btn.btn-sm.btn-outline-dark(
                        href=link.href,
                        target=link.external ? "_blank" : undefined,
                        rel=link.external ? "noopener noreferrer" : undefined
                      )= link.text
          .card-footer.small.text-muted= t("If you have any questions, simply reply to this email.")
