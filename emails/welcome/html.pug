extends ../layout

block content
  .container.mt-3
    .row
      .col-12
        .card.border-dark.d-block.text-center
          h1.h5.card-header= t("Thank you for joining us")
          .card-body.text-center.p-0
            .p-3
              h2.h4= t("Get started")
              p.card-text= t("Add your domain, update its DNS records, and your email starts working with Forward Email.")
              ul.list-inline.mb-0
                li.list-inline-item.mb-2
                  a.btn.btn-lg.btn-primary(
                    href=`${config.urls.web}/${locale}/my-account/domains/new`
                  )= t("Add New Domain")
                if user.plan !== "free"
                  li.list-inline-item.mb-2
                    a.btn.btn-lg.btn-outline-dark(
                      href="https://mail.forwardemail.net",
                      target="_blank",
                      rel="noopener noreferrer"
                    )= t("Open the web app")
            .p-3.bg-light
              h2.h4= t("Features")
              include ../_features
            if user.plan === 'free'
              include ../_upgrade
            .p-3
              h2.h4!= t("Your Account")
              p.card-text!= t("Manage your aliases, domains, settings, and security.")
              a.btn.btn-lg.btn-dark(
                href=`${config.urls.web}/${locale}/my-account`
              )
                = t("My Account")
            .p-3
              h2.h4= t("Need Help?")
              p.card-text!= t("Read our FAQ, submit a help request, or reply to this email.")
              ul.list-inline.mb-0
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark(
                    href=`${config.urls.web}/${locale}/faq`
                  )
                    = t("Read FAQ")
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark(
                    href=`${config.urls.web}/${locale}/help`
                  )
                    = t("Help Request")
          .card-footer.small.text-muted= t("If you have any questions or comments, then please let us know")
