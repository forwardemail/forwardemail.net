extends ../layout

block content
  -
    const whatsNew = [
      {
        title: t("Webmail"),
        text: t("Read and send mail from any browser."),
        href: "https://mail.forwardemail.net",
        link: t("Open the web app"),
        external: true
      },
      {
        title: t("Desktop, mobile and terminal apps"),
        text: t("Native apps for macOS, Windows, Linux, Android, and iOS, and the same app in your terminal."),
        href: `${config.urls.web}/${locale}/download`,
        link: t("See all downloads")
      },
      {
        title: t("Independent security audits"),
        text: t("Tested by Cure53, with the full report published."),
        href: `${config.urls.web}/pentest-report_forward-email.pdf`,
        link: t("Read the security audit"),
        external: true
      },
      {
        title: t("Instant notifications"),
        text: t("New mail, calendar, and contact changes reach your devices right away."),
        href: `${config.urls.web}/${locale}/download`,
        link: t("Download")
      },
      {
        title: t("MCP Server"),
        text: t("Manage email, domains, aliases, contacts, and calendars from AI assistants."),
        href: `${config.urls.web}/${locale}/blog/docs/mcp`,
        link: t("Learn more")
      }
    ];
  .container.mt-3
    .row
      .col-12
        .card.border-dark.d-block
          h1.h5.card-header.text-center= t("Your Forward Email Account")
          .card-body.p-0
            //- Opening message
            .p-3
              p.card-text.mb-0
                = t("Thank you for being a Forward Email subscriber.")
                = " "
                = t("Here is an overview of what your plan includes.")

            //- Features in use (only when using at least one feature)
            if features.using.length > 0
              .p-3.bg-light
                h2.h4.text-center= t("Features You're Using")
                each feature in features.using
                  .email-feature
                    span.email-check.text-success!= "&#10003;"
                    = " "
                    span.email-feature-title= t(feature.title)
                    br
                    span.small= t(feature.description)

            //- Features included but not used yet
            if features.missing.length > 0
              .p-3
                h2.h4.text-center= t("Features Included in Your Plan")
                p.card-text.text-center= t("These are included in your plan at no extra cost:")
                each feature in features.missing
                  .email-feature
                    span.email-check.text-success!= "&#10003;"
                    = " "
                    span.email-feature-title= t(feature.title)
                    br
                    span.small= t(feature.description)
                    if feature.link
                      = " "
                      a.small.font-weight-bold.text-nowrap(
                        href=feature.link,
                        target=feature.external ? "_blank" : undefined,
                        rel=feature.external ? "noopener noreferrer" : undefined
                      )
                        = t(feature.linkText || "Learn more")
                        = " "
                        != "&rarr;"

            //- Recently shipped
            .p-3.bg-light
              h2.h4.text-center= t("What's New")
              each item in whatsNew
                .email-feature
                  span.email-check.text-success!= "&#10003;"
                  = " "
                  span.email-feature-title= item.title
                  br
                  span.small= item.text
                  = " "
                  a.small.font-weight-bold.text-nowrap(
                    href=item.href,
                    target=item.external ? "_blank" : undefined,
                    rel=item.external ? "noopener noreferrer" : undefined
                  )
                    = item.link
                    = " "
                    != "&rarr;"

            //- Quick setup guides
            .p-3.text-center
              h2.h4= t("Quick Setup Guides")
              ul.list-inline.mb-0
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark.btn-sm(
                    href=`${config.urls.web}/${locale}/guides/send-email-with-custom-domain-smtp`
                  )= t("SMTP Setup Guide")
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark.btn-sm(
                    href=`${config.urls.web}/${locale}/faq#do-you-support-receiving-email-with-imap`
                  )= t("IMAP/POP3 Setup")
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark.btn-sm(
                    href=`${config.urls.web}/${locale}/faq#do-you-support-openpgpmime-end-to-end-encryption-e2ee-and-web-key-directory-wkd`
                  )= t("PGP Encryption Guide")
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark.btn-sm(
                    href=`${config.urls.web}/${locale}/faq#how-do-i-import-and-migrate-my-existing-mailbox`
                  )= t("Migration Guide")

            //- Featured reading
            .p-3.bg-light
              h2.h4.text-center= t("Featured Reading")
              p.card-text.mb-1
                strong= t("Technical Deep Dives")
              ul.mb-3
                li
                  a(
                    href=`${config.urls.web}/${locale}/blog/docs/best-quantum-safe-encrypted-email-service`
                  ) How Our Quantum-Resistant Email Service Works
                li
                  a(
                    href=`${config.urls.web}/${locale}/blog/docs/why-open-source-email-security-privacy`
                  ) Why Open Source Email Security & Privacy Matters
                li
                  a(
                    href=`${config.urls.web}/technical-whitepaper.pdf`,
                    target="_blank",
                    rel="noopener noreferrer"
                  )= t("Technical Whitepaper")
                li
                  a(
                    href=`${config.urls.web}/pentest-report_forward-email.pdf`,
                    target="_blank",
                    rel="noopener noreferrer"
                  )= t("Security Audit")
              p.card-text.mb-1
                strong= t("Enterprise Case Studies")
              ul.mb-0
                li
                  a(
                    href=`${config.urls.web}/${locale}/blog/docs/linux-foundation-email-enterprise-case-study`
                  ) The Linux Foundation
                li
                  a(
                    href=`${config.urls.web}/${locale}/blog/docs/canonical-ubuntu-email-enterprise-case-study`
                  ) Canonical / Ubuntu
                li
                  a(
                    href=`${config.urls.web}/${locale}/blog/docs/alumni-email-forwarding-university-case-study`
                  ) University Alumni Email

            //- Resources and community
            .p-3.text-center
              h2.h4= t("Resources")
              ul.list-inline.mb-0
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark.btn-sm(
                    href=`${config.urls.web}/${locale}/faq`
                  )= t("FAQ")
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark.btn-sm(
                    href=`${config.urls.web}/${locale}/email-api`
                  )= t("Email API")
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark.btn-sm(
                    href="https://github.com/forwardemail",
                    target="_blank",
                    rel="noopener noreferrer"
                  )= t("GitHub")
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark.btn-sm(
                    href="https://matrix.to/#/#forwardemail:matrix.org",
                    target="_blank",
                    rel="noopener noreferrer"
                  )= t("Matrix Chat")
                li.list-inline-item.mb-2
                  a.btn.btn-outline-dark.btn-sm(
                    href="https://x.com/fwdemail",
                    target="_blank",
                    rel="noopener noreferrer"
                  )= t("Follow on X")

            //- Account and support
            .p-3.bg-light.text-center
              h2.h4= t("Your Account")
              p.card-text= t("Manage your aliases, domains, settings, and security.")
              ul.list-inline.mb-0
                li.list-inline-item.mb-2
                  a.btn.btn-lg.btn-dark(
                    href=`${config.urls.web}/${locale}/my-account`
                  )= t("My Account")
                li.list-inline-item.mb-2
                  a.btn.btn-lg.btn-outline-dark(
                    href=`${config.urls.web}/${locale}/help`
                  )= t("Help Request")

          .card-footer.text-center.small.text-muted
            = t("Privacy. Transparency. Security. Open Source.")
