//- `doctype html`
!= "<!doctype html>"
html(lang=locale)
  head
    block head
      meta(charset="utf-8")
      meta(name="viewport", content="width=device-width")
      meta(http-equiv="X-UA-Compatible", content="IE=edge")
      meta(name="x-apple-disable-message-reformatting")
      title= subject
      style
        include ../build/css/app-email.css
      //- the site's font, for clients that load web fonts (others fall back
      //- to Helvetica or Arial); data-embed keeps juice from inlining or
      //- removing it
      style(data-embed)
        each weight in [400, 700]
          | @font-face{font-family:'Nunito Sans';font-style:normal;font-weight:#{ weight };font-display:swap;src:url('#{ config.urls.web }/fonts/nunito-sans-latin-#{ weight }.woff2') format('woff2'),url('#{ config.urls.web }/fonts/nunito-sans-latin-#{ weight }.woff') format('woff')}
  body.email
    //- readers that show the message inside their own page (webmail, Gmail)
    //- drop <body> and its styles, so the width is set here as well
    .email-wrapper
      block body
        block messages
          include _messages
        block nav
          include _nav
        block content
          include _content
        block footer
          include _footer
