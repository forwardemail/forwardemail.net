extends ../layout

//- NOTE: `alias`, `destination`, `error`, `from`, `subject`, and
//-       `limitedSender` come from user settings, the sender, or the
//-       receiving mail server, so they are always output escaped (`=`) and
//-       never interpolated into `t()`.
//-
//- NOTE: `mailboxIssue` is why a message could not be stored in a mailbox
//-       (see `helpers/send-forwarding-issue-emails.js`): "quota",
//-       "sender_rate_limit", "recipient_rate_limit", or "unavailable" (any
//-       other reason, shown with its error).

block content
  - const isRateLimit = mailboxIssue === "sender_rate_limit" || mailboxIssue === "recipient_rate_limit";
  .container.mt-3
    .row
      .col-12
        .card.border-dark.d-block
          h1.h5.card-header.text-center= isMailbox ? t("Email delivery issue") : t("Email forwarding issue")
          .card-body
            p.card-text
              if isMailbox
                = t("A message sent to this alias could not be stored in its mailbox.")
              else if isWebhook
                = t("A message sent to this alias could not be delivered to one of its webhooks.")
              else
                = t("A message sent to this alias could not be forwarded to one of its recipients.")
            ul.list-unstyled
              li
                strong= t("Alias")
                = ": "
                code= alias
              if !isMailbox
                li
                  strong= t("Forwarding recipient")
                  = ": "
                  code= destination
              else if mailboxIssue === "sender_rate_limit" && limitedSender
                li
                  strong= t("Sending server")
                  = ": "
                  code= limitedSender
            p.card-text
              if isMailbox
                if mailboxIssue === "quota"
                  = t("The mailbox does not have enough storage for this message.")
                else if mailboxIssue === "sender_rate_limit"
                  = t("The server that sent this message went over our rate limit for incoming mail. This limit applies to the sending server, not to this mailbox or its storage.")
                else if mailboxIssue === "recipient_rate_limit"
                  = t("This mailbox went over its daily limit for incoming messages.")
                else
                  = t("The mailbox could not accept the message.")
                = " "
                if isRetryWindowExceeded
                  = t("Delivery to this mailbox was retried for %s and then stopped.", retryWindow)
                  = " "
              else if isRetryWindowExceeded
                = t("The receiving server kept deferring the message for %s, so delivery to it was stopped.", retryWindow)
                = " "
              if status === 'delivered_to_others'
                = t("The alias's other recipients received the message.")
              else if status === 'not_delivered'
                = t("This alias did not receive the message. Other recipients of the same email did, so the sender was not sent a bounce.")
              else
                = t("The message was not delivered, and the sender received a bounce.")
            if error
              h2.h6= isMailbox ? t("Error") : t("Error from the receiving server")
              p.card-text.bg-light.border.rounded.p-2.small.text-monospace= error
            h2.h6= t("Message")
            ul.list-unstyled.small
              if from
                li
                  strong= t("From")
                  = ": "
                  = from
              if subject
                li
                  strong= t("Subject")
                  = ": "
                  = subject
              if date
                li
                  strong= t("Date")
                  = ": "
                  = date
              if messageId
                li
                  strong= t("Message-ID")
                  = ": "
                  = messageId
            h2.h6= t("How to fix it")
            p.card-text
              if isMailbox
                if mailboxIssue === "quota"
                  = t("Free up storage in this mailbox or in the domain's other mailboxes (they share storage), or add storage to the account.")
                else if isRateLimit
                  = t("No change is needed on this alias or its storage. The limit resets on its own, by midnight UTC at the latest. If you need this message, ask the sender to send it again.")
                else
                  = t("See the error above. If you need this message, ask the sender to send it again.")
              else if isWebhook
                = t("Make sure the webhook URL is correct and responds with a success status, or remove it from the alias.")
              else
                = t("Update or remove this forwarding recipient in the alias settings. If the address is correct, contact the provider that hosts it.")
            if isRateLimit
              a.btn.btn-lg.btn-block.btn-primary(
                href=`${config.urls.web}/${locale}/faq#do-you-have-rate-limiting`,
                role="button"
              )= t("Learn more")
            else if !isMailbox || mailboxIssue === "quota"
              a.btn.btn-lg.btn-block.btn-primary(
                href=`${config.urls.web}/${locale}/my-account/domains/${punycode.toASCII(domainName)}/aliases`,
                role="button"
              )= t("Edit aliases")
          .card-footer.small.text-muted.text-center
            if isMailbox
              = t("This email is sent at most once every %s for the same mailbox and reason.", interval)
            else
              = t("This email is sent at most once every %s for the same recipient.", interval)
